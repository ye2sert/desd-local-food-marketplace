  <bpmn:process id="FoodMarketplacePaymentProcess" name="Food Marketplace Payment Process" processType="None" isClosed="false" isExecutable="true">
    <bpmn:exclusiveGateway id="Gateway_PaymentSuccessful">
      <bpmn:incoming>Flow_14469uh</bpmn:incoming>
      <bpmn:incoming>Flow_104upe6</bpmn:incoming>
      <bpmn:incoming>Flow_1xtqydd</bpmn:incoming>
