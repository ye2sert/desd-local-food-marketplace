      <bpmn:outgoing>Flow_PaymentFailure</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_PaymentSuccess" name="Yes" sourceRef="Gateway_PaymentSuccessful" targetRef="Activity_1cw2l35">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "SUCCESS"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="EndEvent_OrderProcessed" name="Order Processed">
      <bpmn:incoming>Flow_0atd2qh</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_PaymentFailure" name="No" sourceRef="Gateway_PaymentSuccessful" targetRef="Activity_0ztx8b3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "FAILED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="EndEvent_PaymentDeclined" name="Payment Declined">
      <bpmn:incoming>Flow_1ywy1lj</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Activity_08lqxlj" name="Send Payment data">
