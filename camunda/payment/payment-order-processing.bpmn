<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PaymentOrderProcessing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_PaymentOrderProcessing">
    <bpmn:participant id="Participant_PaymentService" name="Payment gateway (sandbox)" />
    <bpmn:participant id="Participant_Marketplace" name="Marketplace – Payment &amp; Order Processing" processRef="PaymentOrderProcessing" />
    <bpmn:participant id="Participant_Producer" name="Producer" />
    <bpmn:messageFlow id="MessageFlow_PaymentRequest" name="Payment request" sourceRef="Task_RequestPayment" targetRef="Participant_PaymentService" />
    <bpmn:messageFlow id="MessageFlow_PaymentResponse" name="Payment result" sourceRef="Participant_PaymentService" targetRef="Task_RequestPayment" />
    <bpmn:messageFlow id="MessageFlow_ProducerNotification" name="Order notification" sourceRef="Task_NotifyProducers" targetRef="Participant_Producer" />
    <bpmn:group id="Group_CalledByCheckout" categoryValueRef="CategoryValue_CalledByCheckout" />
  </bpmn:collaboration>
  <bpmn:category id="Category_Notes">
    <bpmn:categoryValue id="CategoryValue_CalledByCheckout" value="Called by Checkout via call activity (PaymentOrderProcessing)" />
  </bpmn:category>
  <bpmn:error id="Error_PaymentServiceUnavailable" name="Payment service unavailable" errorCode="PAYMENT_SERVICE_UNAVAILABLE" />
  <bpmn:process id="PaymentOrderProcessing" name="Payment &amp; Order Processing" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Marketplace">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Gateway_MergePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterPaymentDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetryOrCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RetryChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderCancelled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Platform" name="Marketplace Platform">
        <bpmn:flowNodeRef>Start_OrderReadyForPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SplitOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_PaymentServiceError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_PaymentTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ServiceDown</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IncrementRetryCount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RetriesLeft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_WaitBeforeRetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FlagForAdmin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyCustomerFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PaymentFailedFlagged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_ProcessConfirmedOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyProducers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ProducersNotified</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_OrderReadyForPayment" name="Order ready for payment">
      <bpmn:outgoing>Flow_StartToCreateOrder</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CreateOrder" name="Create marketplace order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToCreateOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateOrderToSplit</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataAssoc_CreateOrderToOrders">
        <bpmn:targetRef>DataStore_Orders</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="DataStore_Orders" name="Order records" />
    <bpmn:serviceTask id="Task_SplitOrder" name="Split order by producer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="split-order-by-producer" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CreateOrderToSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_SplitToMergePayment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergePayment">
      <bpmn:incoming>Flow_SplitToMergePayment</bpmn:incoming>
      <bpmn:incoming>Flow_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToEnterDetails</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EnterPaymentDetails" name="Enter payment details">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="enter-payment-details" />
        <zeebe:ioMapping>
          <zeebe:output source="=paymentMethod" target="paymentMethod" />
          <zeebe:output source="=paymentToken" target="paymentToken" />
          <zeebe:output source="=0" target="retryCount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MergeToEnterDetails</bpmn:incoming>
      <bpmn:outgoing>Flow_EnterDetailsToMergeRequest</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergeRequest">
      <bpmn:incoming>Flow_EnterDetailsToMergeRequest</bpmn:incoming>
      <bpmn:incoming>Flow_WaitToMergeRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToRequestPayment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RequestPayment" name="Request payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-payment" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="=orderTotal" target="amount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MergeToRequestPayment</bpmn:incoming>
      <bpmn:outgoing>Flow_RequestToResult</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_PaymentServiceError" name="Service unavailable" attachedToRef="Task_RequestPayment">
      <bpmn:outgoing>Flow_ErrorToServiceDown</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_PaymentService" errorRef="Error_PaymentServiceUnavailable" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_PaymentTimeout" name="No response (30s)" attachedToRef="Task_RequestPayment">
      <bpmn:outgoing>Flow_TimeoutToServiceDown</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_PaymentTimeout">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_PaymentResult" name="Payment result?" default="Flow_PaymentDeclined">
      <bpmn:incoming>Flow_RequestToResult</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentSuccess</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentDeclined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_PaymentSuccess" name="Successful" sourceRef="Gateway_PaymentResult" targetRef="Task_SendConfirmation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "SUCCESS"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentDeclined" name="Declined" sourceRef="Gateway_PaymentResult" targetRef="Task_RetryOrCancel" />
    <bpmn:userTask id="Task_RetryOrCancel" name="Payment declined – retry or cancel?">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="payment-declined" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentDeclined</bpmn:incoming>
      <bpmn:outgoing>Flow_RetryOrCancelToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RetryChoice" name="Customer choice?" default="Flow_Cancel">
      <bpmn:incoming>Flow_RetryOrCancelToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Retry" name="Retry" sourceRef="Gateway_RetryChoice" targetRef="Gateway_MergePayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retryChoice = "retry"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Cancel" name="Cancel" sourceRef="Gateway_RetryChoice" targetRef="End_OrderCancelled" />
    <bpmn:endEvent id="End_OrderCancelled" name="Order cancelled">
      <bpmn:incoming>Flow_Cancel</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_ServiceDown">
      <bpmn:incoming>Flow_ErrorToServiceDown</bpmn:incoming>
      <bpmn:incoming>Flow_TimeoutToServiceDown</bpmn:incoming>
      <bpmn:outgoing>Flow_ServiceDownToIncrement</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_IncrementRetryCount" name="Increment retry count">
      <bpmn:extensionElements>
        <zeebe:script expression="=retryCount + 1" resultVariable="retryCount" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ServiceDownToIncrement</bpmn:incoming>
      <bpmn:outgoing>Flow_IncrementToRetriesLeft</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_RetriesLeft" name="Retries left?" default="Flow_NoRetriesLeft">
      <bpmn:incoming>Flow_IncrementToRetriesLeft</bpmn:incoming>
      <bpmn:outgoing>Flow_RetriesLeft</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoRetriesLeft</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_RetriesLeft" name="Yes" sourceRef="Gateway_RetriesLeft" targetRef="Timer_WaitBeforeRetry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retryCount &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoRetriesLeft" name="No" sourceRef="Gateway_RetriesLeft" targetRef="Task_FlagForAdmin" />
    <bpmn:intermediateCatchEvent id="Timer_WaitBeforeRetry" name="Wait 10s before retry">
      <bpmn:incoming>Flow_RetriesLeft</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitToMergeRequest</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_WaitBeforeRetry">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_FlagForAdmin" name="Flag for administrator to check payment status">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="flag-payment-for-admin" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoRetriesLeft</bpmn:incoming>
      <bpmn:outgoing>Flow_FlagToNotifyFailure</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifyCustomerFailure" name="Tell customer payment is pending">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-customer-payment-pending" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FlagToNotifyFailure</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyFailureToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_PaymentFailedFlagged" name="Order held until payment is confirmed">
      <bpmn:incoming>Flow_NotifyFailureToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_SendConfirmation" name="Send order confirmation to customer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-order-confirmation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentSuccess</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfirmationToSubProcess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SubProcess_ProcessConfirmedOrder" name="Process confirmed order">
      <bpmn:incoming>Flow_ConfirmationToSubProcess</bpmn:incoming>
      <bpmn:outgoing>Flow_SubProcessToNotify</bpmn:outgoing>
      <bpmn:startEvent id="Sub_Start" name="Payment confirmed">
        <bpmn:outgoing>Flow_SubStartToStock</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_UpdateStock" name="Update stock">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="update-stock" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SubStartToStock</bpmn:incoming>
        <bpmn:outgoing>Flow_StockToCommission</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DataAssoc_UpdateStockToProducts">
          <bpmn:targetRef>DataStore_Products</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:dataStoreReference id="DataStore_Products" name="Stock levels" />
      <bpmn:serviceTask id="Task_CalculateCommission" name="Calculate producer amounts and 5% commission">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="calculate-commission" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_StockToCommission</bpmn:incoming>
        <bpmn:outgoing>Flow_CommissionToSubEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Sub_End" name="Order processed">
        <bpmn:incoming>Flow_CommissionToSubEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SubStartToStock" sourceRef="Sub_Start" targetRef="Task_UpdateStock" />
      <bpmn:sequenceFlow id="Flow_StockToCommission" sourceRef="Task_UpdateStock" targetRef="Task_CalculateCommission" />
      <bpmn:sequenceFlow id="Flow_CommissionToSubEnd" sourceRef="Task_CalculateCommission" targetRef="Sub_End" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="Task_NotifyProducers" name="Notify producer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-producer" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SubProcessToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyToEnd</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=producerOrders" inputElement="producerOrder" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ProducersNotified" name="Producers notified">
      <bpmn:incoming>Flow_NotifyToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToCreateOrder" sourceRef="Start_OrderReadyForPayment" targetRef="Task_CreateOrder" />
    <bpmn:sequenceFlow id="Flow_CreateOrderToSplit" sourceRef="Task_CreateOrder" targetRef="Task_SplitOrder" />
    <bpmn:sequenceFlow id="Flow_SplitToMergePayment" sourceRef="Task_SplitOrder" targetRef="Gateway_MergePayment" />
    <bpmn:sequenceFlow id="Flow_MergeToEnterDetails" sourceRef="Gateway_MergePayment" targetRef="Task_EnterPaymentDetails" />
    <bpmn:sequenceFlow id="Flow_EnterDetailsToMergeRequest" sourceRef="Task_EnterPaymentDetails" targetRef="Gateway_MergeRequest" />
    <bpmn:sequenceFlow id="Flow_MergeToRequestPayment" sourceRef="Gateway_MergeRequest" targetRef="Task_RequestPayment" />
    <bpmn:sequenceFlow id="Flow_RequestToResult" sourceRef="Task_RequestPayment" targetRef="Gateway_PaymentResult" />
    <bpmn:sequenceFlow id="Flow_RetryOrCancelToGateway" sourceRef="Task_RetryOrCancel" targetRef="Gateway_RetryChoice" />
    <bpmn:sequenceFlow id="Flow_ErrorToServiceDown" sourceRef="Boundary_PaymentServiceError" targetRef="Gateway_ServiceDown" />
    <bpmn:sequenceFlow id="Flow_TimeoutToServiceDown" sourceRef="Boundary_PaymentTimeout" targetRef="Gateway_ServiceDown" />
    <bpmn:sequenceFlow id="Flow_ServiceDownToIncrement" sourceRef="Gateway_ServiceDown" targetRef="Task_IncrementRetryCount" />
    <bpmn:sequenceFlow id="Flow_IncrementToRetriesLeft" sourceRef="Task_IncrementRetryCount" targetRef="Gateway_RetriesLeft" />
    <bpmn:sequenceFlow id="Flow_WaitToMergeRequest" sourceRef="Timer_WaitBeforeRetry" targetRef="Gateway_MergeRequest" />
    <bpmn:sequenceFlow id="Flow_FlagToNotifyFailure" sourceRef="Task_FlagForAdmin" targetRef="Task_NotifyCustomerFailure" />
    <bpmn:sequenceFlow id="Flow_NotifyFailureToEnd" sourceRef="Task_NotifyCustomerFailure" targetRef="End_PaymentFailedFlagged" />
    <bpmn:sequenceFlow id="Flow_ConfirmationToSubProcess" sourceRef="Task_SendConfirmation" targetRef="SubProcess_ProcessConfirmedOrder" />
    <bpmn:sequenceFlow id="Flow_SubProcessToNotify" sourceRef="SubProcess_ProcessConfirmedOrder" targetRef="Task_NotifyProducers" />
    <bpmn:sequenceFlow id="Flow_NotifyToEnd" sourceRef="Task_NotifyProducers" targetRef="End_ProducersNotified" />
    <bpmn:textAnnotation id="TextAnnotation_LeadTime">
      <bpmn:text>Producers get at least 48 hours' notice (LEAD_TIME_HOURS in logic.js)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_LeadTime" associationDirection="None" sourceRef="Task_NotifyProducers" targetRef="TextAnnotation_LeadTime" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Main">
    <bpmndi:BPMNPlane id="BPMNPlane_Main" bpmnElement="Collaboration_PaymentOrderProcessing">
      <bpmndi:BPMNShape id="Participant_PaymentService_di" bpmnElement="Participant_PaymentService" isHorizontal="true">
        <dc:Bounds x="60" y="30" width="1880" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Marketplace_di" bpmnElement="Participant_Marketplace" isHorizontal="true">
        <dc:Bounds x="60" y="130" width="1880" height="700" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Customer_di" bpmnElement="Lane_Customer" isHorizontal="true">
        <dc:Bounds x="90" y="130" width="1850" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Platform_di" bpmnElement="Lane_Platform" isHorizontal="true">
        <dc:Bounds x="90" y="350" width="1850" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Producer_di" bpmnElement="Participant_Producer" isHorizontal="true">
        <dc:Bounds x="60" y="870" width="1880" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Group_CalledByCheckout_di" bpmnElement="Group_CalledByCheckout">
        <dc:Bounds x="132" y="384" width="88" height="110" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="126" y="500" width="160" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_OrderReadyForPayment_di" bpmnElement="Start_OrderReadyForPayment">
        <dc:Bounds x="157" y="422" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateOrder_di" bpmnElement="Task_CreateOrder">
        <dc:Bounds x="220" y="400" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStore_Orders_di" bpmnElement="DataStore_Orders">
        <dc:Bounds x="305" y="600" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SplitOrder_di" bpmnElement="Task_SplitOrder">
        <dc:Bounds x="380" y="400" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergePayment_di" bpmnElement="Gateway_MergePayment" isMarkerVisible="true">
        <dc:Bounds x="535" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnterPaymentDetails_di" bpmnElement="Task_EnterPaymentDetails">
        <dc:Bounds x="610" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeRequest_di" bpmnElement="Gateway_MergeRequest" isMarkerVisible="true">
        <dc:Bounds x="765" y="415" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestPayment_di" bpmnElement="Task_RequestPayment">
        <dc:Bounds x="850" y="400" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PaymentResult_di" bpmnElement="Gateway_PaymentResult" isMarkerVisible="true">
        <dc:Bounds x="1015" y="415" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RetryOrCancel_di" bpmnElement="Task_RetryOrCancel">
        <dc:Bounds x="980" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RetryChoice_di" bpmnElement="Gateway_RetryChoice" isMarkerVisible="true">
        <dc:Bounds x="1145" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OrderCancelled_di" bpmnElement="End_OrderCancelled">
        <dc:Bounds x="1292" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendConfirmation_di" bpmnElement="Task_SendConfirmation">
        <dc:Bounds x="1150" y="400" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_ProcessConfirmedOrder_di" bpmnElement="SubProcess_ProcessConfirmedOrder" isExpanded="false">
        <dc:Bounds x="1330" y="400" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_LeadTime_di" bpmnElement="TextAnnotation_LeadTime">
        <dc:Bounds x="1650" y="510" width="230" height="44" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Association_LeadTime_di" bpmnElement="Association_LeadTime"><di:waypoint x="1615" y="480" /><di:waypoint x="1650" y="525" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Task_NotifyProducers_di" bpmnElement="Task_NotifyProducers">
        <dc:Bounds x="1510" y="400" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ProducersNotified_di" bpmnElement="End_ProducersNotified">
        <dc:Bounds x="1682" y="422" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ServiceDown_di" bpmnElement="Gateway_ServiceDown" isMarkerVisible="true">
        <dc:Bounds x="890" y="555" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_IncrementRetryCount_di" bpmnElement="Task_IncrementRetryCount">
