<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Overview" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="f127538" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_Overview">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer" />
    <bpmn:participant id="Participant_Payment" name="Payment service (test)"><bpmn:documentation>Full name: Payment Service (sandbox)</bpmn:documentation></bpmn:participant>
    <bpmn:participant id="Participant_Marketplace" name="Marketplace" processRef="Process_Marketplace"><bpmn:documentation>Full name: Local Food Marketplace Platform</bpmn:documentation></bpmn:participant>
    <bpmn:participant id="Participant_Cert" name="Certificate checker (test)"><bpmn:documentation>Full name: Certification Service (simulated)</bpmn:documentation></bpmn:participant>
    <bpmn:participant id="Participant_Producer" name="Producers" processRef="Process_Producer"><bpmn:documentation>Full name: Registered Producer</bpmn:documentation></bpmn:participant>
    <bpmn:messageFlow id="Message_BrowseSearch" name="Search" sourceRef="Customer_BrowseProductsAndFillBasket" targetRef="Marketplace_CustomerStartsShopping"><bpmn:documentation>Full name: Browse / search</bpmn:documentation></bpmn:messageFlow>
    <bpmn:messageFlow id="Message_Basket" name="Basket" sourceRef="Customer_ProceedToCheckout" targetRef="Marketplace_CheckoutAndStockValidation" />
    <bpmn:messageFlow id="Message_OrderSummaryStockIssues" name="Summary" sourceRef="Marketplace_CheckoutAndStockValidation" targetRef="Customer_ReviewOrderAmendBasketIfNeededConfirm"><bpmn:documentation>Full name: Order summary / stock issues</bpmn:documentation></bpmn:messageFlow>
    <bpmn:messageFlow id="Message_AmendmentsConfirmation" name="Changes / OK" sourceRef="Customer_ReviewOrderAmendBasketIfNeededConfirm" targetRef="Marketplace_CheckoutAndStockValidation"><bpmn:documentation>Full name: Amendments / confirmation</bpmn:documentation></bpmn:messageFlow>
    <bpmn:messageFlow id="Message_PaymentDetails" name="Payment details" sourceRef="Customer_EnterPaymentDetails" targetRef="Marketplace_PaymentAndOrderProcessing" />
    <bpmn:messageFlow id="Message_OrderConfirmation" name="Confirmed" sourceRef="Marketplace_PaymentAndOrderProcessing" targetRef="Customer_OrderConfirmationReceived"><bpmn:documentation>Full name: Order confirmation</bpmn:documentation></bpmn:messageFlow>
    <bpmn:messageFlow id="Message_PaymentRequest" name="Charge" sourceRef="Marketplace_PaymentAndOrderProcessing" targetRef="Participant_Payment"><bpmn:documentation>Full name: Payment request</bpmn:documentation></bpmn:messageFlow>
    <bpmn:messageFlow id="Message_PaymentResult" name="Paid?" sourceRef="Participant_Payment" targetRef="Marketplace_PaymentAndOrderProcessing"><bpmn:documentation>Full name: Payment result</bpmn:documentation></bpmn:messageFlow>
    <bpmn:messageFlow id="Message_DeliveryCollection" name="Delivery time" sourceRef="Marketplace_CoordinateDeliveryOrCollection" targetRef="Customer_ReceiveDeliveryOrCollectOrder"><bpmn:documentation>Full name: Delivery / collection</bpmn:documentation></bpmn:messageFlow>
    <bpmn:messageFlow id="Message_ProducerOrder" name="Order" sourceRef="Marketplace_PaymentAndOrderProcessing" targetRef="Producer_ProducerOrderReceived"><bpmn:documentation>Full name: Producer order</bpmn:documentation></bpmn:messageFlow>
    <bpmn:messageFlow id="Message_OrderReady" name="Ready" sourceRef="Producer_OrderReady" targetRef="Marketplace_CoordinateDeliveryOrCollection"><bpmn:documentation>Full name: Order ready</bpmn:documentation></bpmn:messageFlow>
    <bpmn:messageFlow id="Message_ProductDetails" name="Product details" sourceRef="Producer_SubmitProductDetails" targetRef="Marketplace_ProductDetailsReceived" />
    <bpmn:messageFlow id="Message_CertificateCheck" name="Certificate check" sourceRef="Marketplace_ValidateProductDetails" targetRef="Participant_Cert" />
    <bpmn:messageFlow id="Message_VerificationResult" name="Result" sourceRef="Participant_Cert" targetRef="Marketplace_ValidateProductDetails"><bpmn:documentation>Full name: Verification result</bpmn:documentation></bpmn:messageFlow>
    <bpmn:messageFlow id="Message_CorrectionsNeeded" name="Please fix" sourceRef="Marketplace_CorrectionsRequested" targetRef="Producer_SubmitProductDetails"><bpmn:documentation>Full name: Corrections needed</bpmn:documentation></bpmn:messageFlow>
    <bpmn:messageFlow id="Message_StockUpdate" name="Stock update" sourceRef="Producer_UpdateStockLevels" targetRef="Marketplace_StockUpdateReceived" />
    <bpmn:messageFlow id="Message_ProblemReport_FromCustomer" name="Problem" sourceRef="Customer_ReportProblem" targetRef="Marketplace_FoodProblemReported"><bpmn:documentation>Full name: Problem report</bpmn:documentation></bpmn:messageFlow>
    <bpmn:messageFlow id="Message_ProblemReport_FromProducer" name="Problem" sourceRef="Producer_ReportProblem" targetRef="Marketplace_FoodProblemReported"><bpmn:documentation>Full name: Problem report</bpmn:documentation></bpmn:messageFlow>
    <bpmn:messageFlow id="Message_InformationRequest" name="Question" sourceRef="Marketplace_RequestInformationFromProducer" targetRef="Producer_InformationRequested"><bpmn:documentation>Full name: Information request</bpmn:documentation></bpmn:messageFlow>
    <bpmn:messageFlow id="Message_ProductInformation" name="Answer" sourceRef="Producer_ProvideProductInformation" targetRef="Marketplace_RequestInformationFromProducer"><bpmn:documentation>Full name: Product information</bpmn:documentation></bpmn:messageFlow>
    <bpmn:messageFlow id="Message_SafetyNotice" name="Warning" sourceRef="Marketplace_SuspendProductAndNotifyAffectedCustomers" targetRef="Customer_SafetyNoticeReceived"><bpmn:documentation>Full name: Safety notice</bpmn:documentation></bpmn:messageFlow>
    <bpmn:messageFlow id="Message_Application" name="Application" sourceRef="Producer_ApplyToSell" targetRef="Marketplace_ProducerApplicationReceived" />
    <bpmn:messageFlow id="Message_PayoutRequest" name="Pay" sourceRef="Marketplace_PayProducersWeekly" targetRef="Participant_Payment"><bpmn:documentation>Full name: Payout request</bpmn:documentation></bpmn:messageFlow><bpmn:messageFlow id="Message_PayoutConfirmation" name="Done" sourceRef="Participant_Payment" targetRef="Marketplace_PayProducersWeekly"><bpmn:documentation>Full name: Payout confirmation</bpmn:documentation></bpmn:messageFlow><bpmn:messageFlow id="Message_WeeklyPayout" name="Money" sourceRef="Participant_Payment" targetRef="Participant_Producer"><bpmn:documentation>Full name: Weekly payout</bpmn:documentation></bpmn:messageFlow><bpmn:messageFlow id="Message_PaymentStatement" name="Statement" sourceRef="Marketplace_PayProducersWeekly" targetRef="Participant_Producer"><bpmn:documentation>Full name: Payment statement</bpmn:documentation></bpmn:messageFlow><bpmn:messageFlow id="Message_SurplusAndRecipes" name="Offers &amp; recipes" sourceRef="Participant_Producer" targetRef="Marketplace_OfferOrRecipeReceived"><bpmn:documentation>Full name: Surplus food or recipes</bpmn:documentation></bpmn:messageFlow><bpmn:messageFlow id="Message_OffersAndRecipes" name="Offers &amp; recipes" sourceRef="Marketplace_ShareOffersAndRecipes" targetRef="Participant_Customer" /><bpmn:textAnnotation id="Note_Overview"><bpmn:text>KEY:
BLUE = our use case (ordering and paying). We build this.
WHITE = the rest of the business, for context.
+ box = click to see inside.</bpmn:text></bpmn:textAnnotation>
    </bpmn:collaboration>
  <bpmn:process id="Process_Customer" name="Customer" isExecutable="false">
    <bpmn:startEvent id="Customer_WantsToBuyLocalFood" name="Wants food">
      <bpmn:documentation>Full name: Wants to buy local food</bpmn:documentation><bpmn:outgoing>Flow_WantsToBuyLocalFood_To_BrowseProductsAndFillBasket</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Customer_BrowseProductsAndFillBasket" name="Fill basket">
      <bpmn:documentation>Full name: Browse products and fill basket</bpmn:documentation><bpmn:incoming>Flow_WantsToBuyLocalFood_To_BrowseProductsAndFillBasket</bpmn:incoming>
      <bpmn:outgoing>Flow_BrowseProductsAndFillBasket_To_ProceedToCheckout</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Customer_ProceedToCheckout" name="Go to checkout">
      <bpmn:documentation>Full name: Proceed to checkout</bpmn:documentation><bpmn:incoming>Flow_BrowseProductsAndFillBasket_To_ProceedToCheckout</bpmn:incoming>
      <bpmn:outgoing>Flow_ProceedToCheckout_To_ReviewOrderAmendBasketIfNeededConfirm</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Customer_ReviewOrderAmendBasketIfNeededConfirm" name="Check and confirm order">
      <bpmn:documentation>Full name: Review order, amend basket if needed, confirm</bpmn:documentation><bpmn:incoming>Flow_ProceedToCheckout_To_ReviewOrderAmendBasketIfNeededConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewOrderAmendBasketIfNeededConfirm_To_EnterPaymentDetails</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Customer_EnterPaymentDetails" name="Pay">
      <bpmn:documentation>Full name: Enter payment details</bpmn:documentation><bpmn:incoming>Flow_ReviewOrderAmendBasketIfNeededConfirm_To_EnterPaymentDetails</bpmn:incoming>
      <bpmn:outgoing>Flow_EnterPaymentDetails_To_OrderConfirmationReceived</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Customer_OrderConfirmationReceived" name="Order confirmed">
      <bpmn:documentation>Full name: Order confirmation received</bpmn:documentation><bpmn:incoming>Flow_EnterPaymentDetails_To_OrderConfirmationReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderConfirmationReceived_To_ReceiveDeliveryOrCollectOrder</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Customer_OrderConfirmationReceived_MessageDefinition" />
    </bpmn:intermediateCatchEvent>
    <bpmn:receiveTask id="Customer_ReceiveDeliveryOrCollectOrder" name="Get the order">
      <bpmn:documentation>Full name: Receive delivery or collect order</bpmn:documentation><bpmn:incoming>Flow_OrderConfirmationReceived_To_ReceiveDeliveryOrCollectOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceiveDeliveryOrCollectOrder_To_OrderReceived</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Customer_OrderReceived" name="Order received">
      <bpmn:incoming>Flow_ReceiveDeliveryOrCollectOrder_To_OrderReceived</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Customer_FindsAFoodProblem" name="Finds a problem">
      <bpmn:documentation>Full name: Finds a food problem</bpmn:documentation><bpmn:outgoing>Flow_FindsAFoodProblem_To_ReportProblem</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="Customer_FindsAFoodProblem_ConditionDefinition"><bpmn:condition xsi:type="bpmn:tFormalExpression" /></bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="Customer_ReportProblem" name="Report problem">
      <bpmn:incoming>Flow_FindsAFoodProblem_To_ReportProblem</bpmn:incoming>
      <bpmn:outgoing>Flow_ReportProblem_To_ProblemReported</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Customer_ProblemReported" name="Problem reported">
      <bpmn:incoming>Flow_ReportProblem_To_ProblemReported</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Customer_SafetyNoticeReceived" name="Gets a warning">
      <bpmn:documentation>Full name: Safety notice received</bpmn:documentation><bpmn:outgoing>Flow_SafetyNoticeReceived_To_FollowSafetyAdvice</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Customer_SafetyNoticeReceived_MessageDefinition" />
    </bpmn:startEvent>
    <bpmn:task id="Customer_FollowSafetyAdvice" name="Follow safety advice">
      <bpmn:incoming>Flow_SafetyNoticeReceived_To_FollowSafetyAdvice</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowSafetyAdvice_To_CustomerInformed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Customer_CustomerInformed" name="Warned">
      <bpmn:documentation>Full name: Customer informed</bpmn:documentation><bpmn:incoming>Flow_FollowSafetyAdvice_To_CustomerInformed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_WantsToBuyLocalFood_To_BrowseProductsAndFillBasket" sourceRef="Customer_WantsToBuyLocalFood" targetRef="Customer_BrowseProductsAndFillBasket" />
    <bpmn:sequenceFlow id="Flow_BrowseProductsAndFillBasket_To_ProceedToCheckout" sourceRef="Customer_BrowseProductsAndFillBasket" targetRef="Customer_ProceedToCheckout" />
    <bpmn:sequenceFlow id="Flow_ProceedToCheckout_To_ReviewOrderAmendBasketIfNeededConfirm" sourceRef="Customer_ProceedToCheckout" targetRef="Customer_ReviewOrderAmendBasketIfNeededConfirm" />
    <bpmn:sequenceFlow id="Flow_ReviewOrderAmendBasketIfNeededConfirm_To_EnterPaymentDetails" sourceRef="Customer_ReviewOrderAmendBasketIfNeededConfirm" targetRef="Customer_EnterPaymentDetails" />
    <bpmn:sequenceFlow id="Flow_EnterPaymentDetails_To_OrderConfirmationReceived" sourceRef="Customer_EnterPaymentDetails" targetRef="Customer_OrderConfirmationReceived" />
    <bpmn:sequenceFlow id="Flow_OrderConfirmationReceived_To_ReceiveDeliveryOrCollectOrder" sourceRef="Customer_OrderConfirmationReceived" targetRef="Customer_ReceiveDeliveryOrCollectOrder" />
    <bpmn:sequenceFlow id="Flow_ReceiveDeliveryOrCollectOrder_To_OrderReceived" sourceRef="Customer_ReceiveDeliveryOrCollectOrder" targetRef="Customer_OrderReceived" />
    <bpmn:sequenceFlow id="Flow_FindsAFoodProblem_To_ReportProblem" sourceRef="Customer_FindsAFoodProblem" targetRef="Customer_ReportProblem" />
    <bpmn:sequenceFlow id="Flow_ReportProblem_To_ProblemReported" sourceRef="Customer_ReportProblem" targetRef="Customer_ProblemReported" />
    <bpmn:sequenceFlow id="Flow_SafetyNoticeReceived_To_FollowSafetyAdvice" sourceRef="Customer_SafetyNoticeReceived" targetRef="Customer_FollowSafetyAdvice" />
    <bpmn:sequenceFlow id="Flow_FollowSafetyAdvice_To_CustomerInformed" sourceRef="Customer_FollowSafetyAdvice" targetRef="Customer_CustomerInformed" />
  </bpmn:process>
  <bpmn:process id="Process_Marketplace" name="Local Food Marketplace Platform" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Marketplace">
      <bpmn:lane id="Lane_Orders" name="Orders &amp; Payments">
        <bpmn:flowNodeRef>Marketplace_CustomerStartsShopping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_FindProducts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_CheckoutAndStockValidation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_PaymentAndOrderProcessing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_CoordinateDeliveryOrCollection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_OrderComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_CheckoutCancelledOrTimedOut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_CheckoutAbandoned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_PaymentFailedAfterRetries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_OrderNotPlaced</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Marketplace_EveryWeek</bpmn:flowNodeRef><bpmn:flowNodeRef>Marketplace_PayProducersWeekly</bpmn:flowNodeRef><bpmn:flowNodeRef>Marketplace_ProducersPaid</bpmn:flowNodeRef><bpmn:flowNodeRef>Marketplace_OfferOrRecipeReceived</bpmn:flowNodeRef><bpmn:flowNodeRef>Marketplace_ShareOffersAndRecipes</bpmn:flowNodeRef><bpmn:flowNodeRef>Marketplace_CustomersInformed</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Staff" name="Staff">
        <bpmn:documentation>Full name: Marketplace Staff (food safety &amp; onboarding)</bpmn:documentation><bpmn:flowNodeRef>Marketplace_FoodProblemReported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_RecordIncidentAndIdentifyProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_RequestInformationFromProducer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_GenuineRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_SuspendProductAndNotifyAffectedCustomers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_ReviewIncident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_IncidentClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_NoGenuineRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_ProducerApplicationReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_VerifyAndRegisterProducer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_ProducerRegistered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Products" name="Products &amp; stock">
        <bpmn:documentation>Full name: Products &amp; Inventory</bpmn:documentation><bpmn:flowNodeRef>Marketplace_ProductDetailsReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_ValidateProductDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_DetailsValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_PublishProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_ProductAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_CorrectionsRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_StockUpdateReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_UpdateStockAndAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Marketplace_AvailabilityUpdated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Marketplace_CustomerStartsShopping" name="Customer arrives">
      <bpmn:documentation>Full name: Customer starts shopping</bpmn:documentation><bpmn:outgoing>Flow_CustomerStartsShopping_To_FindProducts</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Marketplace_CustomerStartsShopping_MessageDefinition" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Marketplace_FindProducts" name="Show products">
      <bpmn:documentation>Full name: Find products</bpmn:documentation><bpmn:incoming>Flow_CustomerStartsShopping_To_FindProducts</bpmn:incoming>
      <bpmn:outgoing>Flow_FindProducts_To_CheckoutAndStockValidation</bpmn:outgoing>
      <bpmn:property id="FindProducts_Reads_ProductAndStockRecords_Input" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="FindProducts_Reads_ProductAndStockRecords"><bpmn:sourceRef>ProductAndStockRecords_Checkout</bpmn:sourceRef><bpmn:targetRef>FindProducts_Reads_ProductAndStockRecords_Input</bpmn:targetRef></bpmn:dataInputAssociation>
      <bpmn:startEvent id="FindProducts_SearchStarted" name="Search started">
        <bpmn:outgoing>Flow_SearchStarted_To_SearchOrBrowseTheCatalogue</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="FindProducts_SearchOrBrowseTheCatalogue" name="Search or browse the catalogue">
        <bpmn:incoming>Flow_SearchStarted_To_SearchOrBrowseTheCatalogue</bpmn:incoming>
        <bpmn:outgoing>Flow_SearchOrBrowseTheCatalogue_To_ShowProductsThatAreInStock</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="FindProducts_ShowProductsThatAreInStock" name="Show products that are in stock">
        <bpmn:incoming>Flow_SearchOrBrowseTheCatalogue_To_ShowProductsThatAreInStock</bpmn:incoming>
        <bpmn:outgoing>Flow_ShowProductsThatAreInStock_To_ProductsShown</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="FindProducts_ProductsShown" name="Products shown">
        <bpmn:incoming>Flow_ShowProductsThatAreInStock_To_ProductsShown</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SearchStarted_To_SearchOrBrowseTheCatalogue" sourceRef="FindProducts_SearchStarted" targetRef="FindProducts_SearchOrBrowseTheCatalogue" />
      <bpmn:sequenceFlow id="Flow_SearchOrBrowseTheCatalogue_To_ShowProductsThatAreInStock" sourceRef="FindProducts_SearchOrBrowseTheCatalogue" targetRef="FindProducts_ShowProductsThatAreInStock" />
      <bpmn:sequenceFlow id="Flow_ShowProductsThatAreInStock_To_ProductsShown" sourceRef="FindProducts_ShowProductsThatAreInStock" targetRef="FindProducts_ProductsShown" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Marketplace_CheckoutAndStockValidation" name="Checkout &amp; Stock Check">
      <bpmn:documentation>Full name: Checkout &amp; Stock Validation</bpmn:documentation><bpmn:incoming>Flow_FindProducts_To_CheckoutAndStockValidation</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckoutAndStockValidation_To_PaymentAndOrderProcessing</bpmn:outgoing>
      <bpmn:property id="CheckoutAndStockValidation_Reads_ProductAndStockRecords_Input" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="CheckoutAndStockValidation_Reads_ProductAndStockRecords"><bpmn:sourceRef>ProductAndStockRecords_Checkout</bpmn:sourceRef><bpmn:targetRef>CheckoutAndStockValidation_Reads_ProductAndStockRecords_Input</bpmn:targetRef></bpmn:dataInputAssociation>
      <bpmn:startEvent id="CheckoutAndStockValidation_CheckoutStarted" name="Checkout started">
        <bpmn:outgoing>Flow_CheckoutStarted_To_StockCheckMerge</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="CheckoutAndStockValidation_StockCheckMerge" name="">
        <bpmn:incoming>Flow_CheckoutStarted_To_StockCheckMerge</bpmn:incoming>
        <bpmn:incoming>Flow_ContinueWithOrder_To_StockCheckMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_StockCheckMerge_To_CheckStockForEachItem</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="CheckoutAndStockValidation_CheckStockForEachItem" name="Check stock for each item">
        <bpmn:incoming>Flow_StockCheckMerge_To_CheckStockForEachItem</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckStockForEachItem_To_AllItemsInStock</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="CheckoutAndStockValidation_AllItemsInStock" name="All items in stock?">
        <bpmn:incoming>Flow_CheckStockForEachItem_To_AllItemsInStock</bpmn:incoming>
        <bpmn:outgoing>Flow_AllItemsInStock_To_IdentifyProducersInvolved</bpmn:outgoing>
        <bpmn:outgoing>Flow_AllItemsInStock_To_AskCustomerToAmendBasket</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="CheckoutAndStockValidation_IdentifyProducersInvolved" name="Identify producers involved">
        <bpmn:incoming>Flow_AllItemsInStock_To_IdentifyProducersInvolved</bpmn:incoming>
        <bpmn:outgoing>Flow_IdentifyProducersInvolved_To_DetermineDeliveryOrCollection</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="CheckoutAndStockValidation_DetermineDeliveryOrCollection" name="Determine delivery or collection">
        <bpmn:incoming>Flow_IdentifyProducersInvolved_To_DetermineDeliveryOrCollection</bpmn:incoming>
        <bpmn:outgoing>Flow_DetermineDeliveryOrCollection_To_CustomerReviewsAndConfirmsOrder</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="CheckoutAndStockValidation_CustomerReviewsAndConfirmsOrder" name="Customer reviews and confirms order">
        <bpmn:incoming>Flow_DetermineDeliveryOrCollection_To_CustomerReviewsAndConfirmsOrder</bpmn:incoming>
        <bpmn:outgoing>Flow_CustomerReviewsAndConfirmsOrder_To_OrderReadyForPayment</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="CheckoutAndStockValidation_OrderReadyForPayment" name="Order ready for payment">
        <bpmn:incoming>Flow_CustomerReviewsAndConfirmsOrder_To_OrderReadyForPayment</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="CheckoutAndStockValidation_AskCustomerToAmendBasket" name="Ask customer to amend basket">
        <bpmn:incoming>Flow_AllItemsInStock_To_AskCustomerToAmendBasket</bpmn:incoming>
        <bpmn:outgoing>Flow_AskCustomerToAmendBasket_To_ContinueWithOrder</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="CheckoutAndStockValidation_ContinueWithOrder" name="Continue with order?">
        <bpmn:incoming>Flow_AskCustomerToAmendBasket_To_ContinueWithOrder</bpmn:incoming>
        <bpmn:outgoing>Flow_ContinueWithOrder_To_CheckoutCancelled</bpmn:outgoing>
        <bpmn:outgoing>Flow_ContinueWithOrder_To_StockCheckMerge</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="CheckoutAndStockValidation_CheckoutCancelled" name="Checkout cancelled">
        <bpmn:incoming>Flow_ContinueWithOrder_To_CheckoutCancelled</bpmn:incoming>
        <bpmn:errorEventDefinition id="CheckoutAndStockValidation_CheckoutCancelled_ErrorDefinition" errorRef="Error_CheckoutCancelled" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_CheckoutStarted_To_StockCheckMerge" sourceRef="CheckoutAndStockValidation_CheckoutStarted" targetRef="CheckoutAndStockValidation_StockCheckMerge" />
      <bpmn:sequenceFlow id="Flow_StockCheckMerge_To_CheckStockForEachItem" sourceRef="CheckoutAndStockValidation_StockCheckMerge" targetRef="CheckoutAndStockValidation_CheckStockForEachItem" />
      <bpmn:sequenceFlow id="Flow_CheckStockForEachItem_To_AllItemsInStock" sourceRef="CheckoutAndStockValidation_CheckStockForEachItem" targetRef="CheckoutAndStockValidation_AllItemsInStock" />
      <bpmn:sequenceFlow id="Flow_IdentifyProducersInvolved_To_DetermineDeliveryOrCollection" sourceRef="CheckoutAndStockValidation_IdentifyProducersInvolved" targetRef="CheckoutAndStockValidation_DetermineDeliveryOrCollection" />
      <bpmn:sequenceFlow id="Flow_DetermineDeliveryOrCollection_To_CustomerReviewsAndConfirmsOrder" sourceRef="CheckoutAndStockValidation_DetermineDeliveryOrCollection" targetRef="CheckoutAndStockValidation_CustomerReviewsAndConfirmsOrder" />
      <bpmn:sequenceFlow id="Flow_CustomerReviewsAndConfirmsOrder_To_OrderReadyForPayment" sourceRef="CheckoutAndStockValidation_CustomerReviewsAndConfirmsOrder" targetRef="CheckoutAndStockValidation_OrderReadyForPayment" />
      <bpmn:sequenceFlow id="Flow_AskCustomerToAmendBasket_To_ContinueWithOrder" sourceRef="CheckoutAndStockValidation_AskCustomerToAmendBasket" targetRef="CheckoutAndStockValidation_ContinueWithOrder" />
      <bpmn:sequenceFlow id="Flow_AllItemsInStock_To_IdentifyProducersInvolved" name="Yes" sourceRef="CheckoutAndStockValidation_AllItemsInStock" targetRef="CheckoutAndStockValidation_IdentifyProducersInvolved" />
      <bpmn:sequenceFlow id="Flow_AllItemsInStock_To_AskCustomerToAmendBasket" name="No" sourceRef="CheckoutAndStockValidation_AllItemsInStock" targetRef="CheckoutAndStockValidation_AskCustomerToAmendBasket" />
      <bpmn:sequenceFlow id="Flow_ContinueWithOrder_To_CheckoutCancelled" name="No" sourceRef="CheckoutAndStockValidation_ContinueWithOrder" targetRef="CheckoutAndStockValidation_CheckoutCancelled" />
      <bpmn:sequenceFlow id="Flow_ContinueWithOrder_To_StockCheckMerge" name="Yes" sourceRef="CheckoutAndStockValidation_ContinueWithOrder" targetRef="CheckoutAndStockValidation_StockCheckMerge" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Marketplace_PaymentAndOrderProcessing" name="Payment &amp; Order">
      <bpmn:documentation>Full name: Payment &amp; Order Processing</bpmn:documentation><bpmn:incoming>Flow_CheckoutAndStockValidation_To_PaymentAndOrderProcessing</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentAndOrderProcessing_To_CoordinateDeliveryOrCollection</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="PaymentAndOrderProcessing_Updates_OrderCustomerAndProducerRecords"><bpmn:targetRef>OrderCustomerAndProducerRecords_OrderProcessing</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="PaymentAndOrderProcessing_Updates_ProductAndStockRecords"><bpmn:targetRef>ProductAndStockRecords_OrderProcessing</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:startEvent id="PaymentAndOrderProcessing_OrderConfirmedByCustomer" name="Order confirmed by customer">
        <bpmn:outgoing>Flow_OrderConfirmedByCustomer_To_CreateMarketplaceOrder</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="PaymentAndOrderProcessing_CreateMarketplaceOrder" name="Create marketplace order">
        <bpmn:incoming>Flow_OrderConfirmedByCustomer_To_CreateMarketplaceOrder</bpmn:incoming>
        <bpmn:outgoing>Flow_CreateMarketplaceOrder_To_SplitOrderByProducer</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="PaymentAndOrderProcessing_SplitOrderByProducer" name="Split order by producer">
        <bpmn:incoming>Flow_CreateMarketplaceOrder_To_SplitOrderByProducer</bpmn:incoming>
        <bpmn:outgoing>Flow_SplitOrderByProducer_To_PaymentAttemptMerge</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="PaymentAndOrderProcessing_PaymentAttemptMerge" name="">
        <bpmn:incoming>Flow_SplitOrderByProducer_To_PaymentAttemptMerge</bpmn:incoming>
        <bpmn:incoming>Flow_RetryPayment_To_PaymentAttemptMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_PaymentAttemptMerge_To_SendPaymentToPaymentService</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="PaymentAndOrderProcessing_SendPaymentToPaymentService" name="Send payment to payment service">
        <bpmn:incoming>Flow_PaymentAttemptMerge_To_SendPaymentToPaymentService</bpmn:incoming>
        <bpmn:outgoing>Flow_SendPaymentToPaymentService_To_PaymentSuccessful</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="PaymentAndOrderProcessing_PaymentSuccessful" name="Payment successful?">
        <bpmn:incoming>Flow_SendPaymentToPaymentService_To_PaymentSuccessful</bpmn:incoming>
        <bpmn:outgoing>Flow_PaymentSuccessful_To_ConfirmOrder</bpmn:outgoing>
        <bpmn:outgoing>Flow_PaymentSuccessful_To_TellCustomerThePaymentDidNotGoThrough</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="PaymentAndOrderProcessing_ConfirmOrder" name="Confirm order">
        <bpmn:incoming>Flow_PaymentSuccessful_To_ConfirmOrder</bpmn:incoming>
        <bpmn:outgoing>Flow_ConfirmOrder_To_UpdateStock</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="PaymentAndOrderProcessing_UpdateStock" name="Update stock">
        <bpmn:incoming>Flow_ConfirmOrder_To_UpdateStock</bpmn:incoming>
        <bpmn:outgoing>Flow_UpdateStock_To_NotifyProducers</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="PaymentAndOrderProcessing_NotifyProducers" name="Notify producers">
        <bpmn:incoming>Flow_UpdateStock_To_NotifyProducers</bpmn:incoming>
        <bpmn:outgoing>Flow_NotifyProducers_To_CalculateProducerAmountsAnd5Commission</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="PaymentAndOrderProcessing_CalculateProducerAmountsAnd5Commission" name="Calculate producer amounts and 5% commission">
        <bpmn:incoming>Flow_NotifyProducers_To_CalculateProducerAmountsAnd5Commission</bpmn:incoming>
        <bpmn:outgoing>Flow_CalculateProducerAmountsAnd5Commission_To_OrderPlaced</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="PaymentAndOrderProcessing_OrderPlaced" name="Order placed">
        <bpmn:incoming>Flow_CalculateProducerAmountsAnd5Commission_To_OrderPlaced</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="PaymentAndOrderProcessing_TellCustomerThePaymentDidNotGoThrough" name="Tell customer the payment did not go through">
        <bpmn:incoming>Flow_PaymentSuccessful_To_TellCustomerThePaymentDidNotGoThrough</bpmn:incoming>
        <bpmn:outgoing>Flow_TellCustomerThePaymentDidNotGoThrough_To_RetryPayment</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="PaymentAndOrderProcessing_RetryPayment" name="Retry payment?">
        <bpmn:incoming>Flow_TellCustomerThePaymentDidNotGoThrough_To_RetryPayment</bpmn:incoming>
        <bpmn:outgoing>Flow_RetryPayment_To_PaymentFailed</bpmn:outgoing>
        <bpmn:outgoing>Flow_RetryPayment_To_PaymentAttemptMerge</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="PaymentAndOrderProcessing_PaymentFailed" name="Payment failed">
        <bpmn:incoming>Flow_RetryPayment_To_PaymentFailed</bpmn:incoming>
        <bpmn:errorEventDefinition id="PaymentAndOrderProcessing_PaymentFailed_ErrorDefinition" errorRef="Error_PaymentFailed" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_OrderConfirmedByCustomer_To_CreateMarketplaceOrder" sourceRef="PaymentAndOrderProcessing_OrderConfirmedByCustomer" targetRef="PaymentAndOrderProcessing_CreateMarketplaceOrder" />
      <bpmn:sequenceFlow id="Flow_CreateMarketplaceOrder_To_SplitOrderByProducer" sourceRef="PaymentAndOrderProcessing_CreateMarketplaceOrder" targetRef="PaymentAndOrderProcessing_SplitOrderByProducer" />
      <bpmn:sequenceFlow id="Flow_SplitOrderByProducer_To_PaymentAttemptMerge" sourceRef="PaymentAndOrderProcessing_SplitOrderByProducer" targetRef="PaymentAndOrderProcessing_PaymentAttemptMerge" />
      <bpmn:sequenceFlow id="Flow_PaymentAttemptMerge_To_SendPaymentToPaymentService" sourceRef="PaymentAndOrderProcessing_PaymentAttemptMerge" targetRef="PaymentAndOrderProcessing_SendPaymentToPaymentService" />
      <bpmn:sequenceFlow id="Flow_SendPaymentToPaymentService_To_PaymentSuccessful" sourceRef="PaymentAndOrderProcessing_SendPaymentToPaymentService" targetRef="PaymentAndOrderProcessing_PaymentSuccessful" />
      <bpmn:sequenceFlow id="Flow_ConfirmOrder_To_UpdateStock" sourceRef="PaymentAndOrderProcessing_ConfirmOrder" targetRef="PaymentAndOrderProcessing_UpdateStock" />
      <bpmn:sequenceFlow id="Flow_UpdateStock_To_NotifyProducers" sourceRef="PaymentAndOrderProcessing_UpdateStock" targetRef="PaymentAndOrderProcessing_NotifyProducers" />
      <bpmn:sequenceFlow id="Flow_NotifyProducers_To_CalculateProducerAmountsAnd5Commission" sourceRef="PaymentAndOrderProcessing_NotifyProducers" targetRef="PaymentAndOrderProcessing_CalculateProducerAmountsAnd5Commission" />
      <bpmn:sequenceFlow id="Flow_CalculateProducerAmountsAnd5Commission_To_OrderPlaced" sourceRef="PaymentAndOrderProcessing_CalculateProducerAmountsAnd5Commission" targetRef="PaymentAndOrderProcessing_OrderPlaced" />
      <bpmn:sequenceFlow id="Flow_TellCustomerThePaymentDidNotGoThrough_To_RetryPayment" sourceRef="PaymentAndOrderProcessing_TellCustomerThePaymentDidNotGoThrough" targetRef="PaymentAndOrderProcessing_RetryPayment" />
      <bpmn:sequenceFlow id="Flow_PaymentSuccessful_To_ConfirmOrder" name="Yes" sourceRef="PaymentAndOrderProcessing_PaymentSuccessful" targetRef="PaymentAndOrderProcessing_ConfirmOrder" />
      <bpmn:sequenceFlow id="Flow_PaymentSuccessful_To_TellCustomerThePaymentDidNotGoThrough" name="No" sourceRef="PaymentAndOrderProcessing_PaymentSuccessful" targetRef="PaymentAndOrderProcessing_TellCustomerThePaymentDidNotGoThrough" />
      <bpmn:sequenceFlow id="Flow_RetryPayment_To_PaymentFailed" name="No" sourceRef="PaymentAndOrderProcessing_RetryPayment" targetRef="PaymentAndOrderProcessing_PaymentFailed" />
      <bpmn:sequenceFlow id="Flow_RetryPayment_To_PaymentAttemptMerge" name="Yes" sourceRef="PaymentAndOrderProcessing_RetryPayment" targetRef="PaymentAndOrderProcessing_PaymentAttemptMerge" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Marketplace_CoordinateDeliveryOrCollection" name="Arrange delivery">
      <bpmn:documentation>Full name: Coordinate delivery or collection</bpmn:documentation><bpmn:incoming>Flow_PaymentAndOrderProcessing_To_CoordinateDeliveryOrCollection</bpmn:incoming>
      <bpmn:outgoing>Flow_CoordinateDeliveryOrCollection_To_OrderComplete</bpmn:outgoing>
      <bpmn:startEvent id="CoordinateDeliveryOrCollection_ProducerOrdersReady" name="Producer orders ready">
        <bpmn:outgoing>Flow_ProducerOrdersReady_To_ArrangeDeliveryOrCollectionSlot</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="CoordinateDeliveryOrCollection_ArrangeDeliveryOrCollectionSlot" name="Arrange delivery or collection slot">
        <bpmn:incoming>Flow_ProducerOrdersReady_To_ArrangeDeliveryOrCollectionSlot</bpmn:incoming>
        <bpmn:outgoing>Flow_ArrangeDeliveryOrCollectionSlot_To_UpdateTheCustomer</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="CoordinateDeliveryOrCollection_UpdateTheCustomer" name="Update the customer">
        <bpmn:incoming>Flow_ArrangeDeliveryOrCollectionSlot_To_UpdateTheCustomer</bpmn:incoming>
        <bpmn:outgoing>Flow_UpdateTheCustomer_To_OrderHandedOver</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="CoordinateDeliveryOrCollection_OrderHandedOver" name="Order handed over">
        <bpmn:incoming>Flow_UpdateTheCustomer_To_OrderHandedOver</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ProducerOrdersReady_To_ArrangeDeliveryOrCollectionSlot" sourceRef="CoordinateDeliveryOrCollection_ProducerOrdersReady" targetRef="CoordinateDeliveryOrCollection_ArrangeDeliveryOrCollectionSlot" />
      <bpmn:sequenceFlow id="Flow_ArrangeDeliveryOrCollectionSlot_To_UpdateTheCustomer" sourceRef="CoordinateDeliveryOrCollection_ArrangeDeliveryOrCollectionSlot" targetRef="CoordinateDeliveryOrCollection_UpdateTheCustomer" />
      <bpmn:sequenceFlow id="Flow_UpdateTheCustomer_To_OrderHandedOver" sourceRef="CoordinateDeliveryOrCollection_UpdateTheCustomer" targetRef="CoordinateDeliveryOrCollection_OrderHandedOver" />
    </bpmn:subProcess>
    <bpmn:endEvent id="Marketplace_OrderComplete" name="Order done">
      <bpmn:documentation>Full name: Order complete</bpmn:documentation><bpmn:incoming>Flow_CoordinateDeliveryOrCollection_To_OrderComplete</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Marketplace_CheckoutCancelledOrTimedOut" name="Cancelled" attachedToRef="Marketplace_CheckoutAndStockValidation">
      <bpmn:documentation>Full name: Checkout cancelled or timed out</bpmn:documentation><bpmn:outgoing>Flow_CheckoutCancelledOrTimedOut_To_CheckoutAbandoned</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Marketplace_CheckoutCancelledOrTimedOut_ErrorDefinition" errorRef="Error_CheckoutCancelled" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Marketplace_CheckoutAbandoned" name="No order">
      <bpmn:documentation>Full name: Checkout abandoned</bpmn:documentation><bpmn:incoming>Flow_CheckoutCancelledOrTimedOut_To_CheckoutAbandoned</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Marketplace_PaymentFailedAfterRetries" name="Payment failed" attachedToRef="Marketplace_PaymentAndOrderProcessing">
      <bpmn:documentation>Full name: Payment failed after retries</bpmn:documentation><bpmn:outgoing>Flow_PaymentFailedAfterRetries_To_OrderNotPlaced</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Marketplace_PaymentFailedAfterRetries_ErrorDefinition" errorRef="Error_PaymentFailed" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Marketplace_OrderNotPlaced" name="No order">
      <bpmn:documentation>Full name: Order not placed</bpmn:documentation><bpmn:incoming>Flow_PaymentFailedAfterRetries_To_OrderNotPlaced</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Marketplace_FoodProblemReported" name="Problem received">
      <bpmn:documentation>Full name: Food problem reported</bpmn:documentation><bpmn:outgoing>Flow_FoodProblemReported_To_RecordIncidentAndIdentifyProduct</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Marketplace_FoodProblemReported_MessageDefinition" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Marketplace_RecordIncidentAndIdentifyProduct" name="Log the problem">
      <bpmn:documentation>Full name: Record incident and identify product</bpmn:documentation><bpmn:incoming>Flow_FoodProblemReported_To_RecordIncidentAndIdentifyProduct</bpmn:incoming>
      <bpmn:outgoing>Flow_RecordIncidentAndIdentifyProduct_To_RequestInformationFromProducer</bpmn:outgoing>
      <bpmn:property id="RecordIncidentAndIdentifyProduct_Reads_OrderCustomerAndProducerRecords_Input" name="__targetRef_placeholder" />
      <bpmn:startEvent id="RecordIncidentAndIdentifyProduct_IncidentReceived" name="Incident received">
        <bpmn:outgoing>Flow_IncidentReceived_To_CreateIncidentRecord</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="RecordIncidentAndIdentifyProduct_CreateIncidentRecord" name="Create incident record">
        <bpmn:incoming>Flow_IncidentReceived_To_CreateIncidentRecord</bpmn:incoming>
        <bpmn:outgoing>Flow_CreateIncidentRecord_To_IdentifyProductAndProducer</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="RecordIncidentAndIdentifyProduct_IdentifyProductAndProducer" name="Identify product and producer">
        <bpmn:incoming>Flow_CreateIncidentRecord_To_IdentifyProductAndProducer</bpmn:incoming>
        <bpmn:outgoing>Flow_IdentifyProductAndProducer_To_FindOrdersContainingTheProduct</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="RecordIncidentAndIdentifyProduct_FindOrdersContainingTheProduct" name="Find orders containing the product">
        <bpmn:incoming>Flow_IdentifyProductAndProducer_To_FindOrdersContainingTheProduct</bpmn:incoming>
        <bpmn:outgoing>Flow_FindOrdersContainingTheProduct_To_IncidentRecorded</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="RecordIncidentAndIdentifyProduct_IncidentRecorded" name="Incident recorded">
        <bpmn:incoming>Flow_FindOrdersContainingTheProduct_To_IncidentRecorded</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_IncidentReceived_To_CreateIncidentRecord" sourceRef="RecordIncidentAndIdentifyProduct_IncidentReceived" targetRef="RecordIncidentAndIdentifyProduct_CreateIncidentRecord" />
      <bpmn:sequenceFlow id="Flow_CreateIncidentRecord_To_IdentifyProductAndProducer" sourceRef="RecordIncidentAndIdentifyProduct_CreateIncidentRecord" targetRef="RecordIncidentAndIdentifyProduct_IdentifyProductAndProducer" />
      <bpmn:sequenceFlow id="Flow_IdentifyProductAndProducer_To_FindOrdersContainingTheProduct" sourceRef="RecordIncidentAndIdentifyProduct_IdentifyProductAndProducer" targetRef="RecordIncidentAndIdentifyProduct_FindOrdersContainingTheProduct" />
      <bpmn:sequenceFlow id="Flow_FindOrdersContainingTheProduct_To_IncidentRecorded" sourceRef="RecordIncidentAndIdentifyProduct_FindOrdersContainingTheProduct" targetRef="RecordIncidentAndIdentifyProduct_IncidentRecorded" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Marketplace_RequestInformationFromProducer" name="Ask the producer">
      <bpmn:documentation>Full name: Request information from producer</bpmn:documentation><bpmn:incoming>Flow_RecordIncidentAndIdentifyProduct_To_RequestInformationFromProducer</bpmn:incoming>
      <bpmn:outgoing>Flow_RequestInformationFromProducer_To_GenuineRisk</bpmn:outgoing>
      <bpmn:startEvent id="RequestInformationFromProducer_InformationNeeded" name="Information needed">
        <bpmn:outgoing>Flow_InformationNeeded_To_SendInformationRequestToProducer</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="RequestInformationFromProducer_SendInformationRequestToProducer" name="Send information request to producer">
        <bpmn:incoming>Flow_InformationNeeded_To_SendInformationRequestToProducer</bpmn:incoming>
        <bpmn:outgoing>Flow_SendInformationRequestToProducer_To_RecordProducerResponse</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="RequestInformationFromProducer_RecordProducerResponse" name="Record producer response">
        <bpmn:incoming>Flow_SendInformationRequestToProducer_To_RecordProducerResponse</bpmn:incoming>
        <bpmn:outgoing>Flow_RecordProducerResponse_To_ResponseRecorded</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="RequestInformationFromProducer_ResponseRecorded" name="Response recorded">
        <bpmn:incoming>Flow_RecordProducerResponse_To_ResponseRecorded</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_InformationNeeded_To_SendInformationRequestToProducer" sourceRef="RequestInformationFromProducer_InformationNeeded" targetRef="RequestInformationFromProducer_SendInformationRequestToProducer" />
      <bpmn:sequenceFlow id="Flow_SendInformationRequestToProducer_To_RecordProducerResponse" sourceRef="RequestInformationFromProducer_SendInformationRequestToProducer" targetRef="RequestInformationFromProducer_RecordProducerResponse" />
      <bpmn:sequenceFlow id="Flow_RecordProducerResponse_To_ResponseRecorded" sourceRef="RequestInformationFromProducer_RecordProducerResponse" targetRef="RequestInformationFromProducer_ResponseRecorded" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Marketplace_GenuineRisk" name="Real risk?">
      <bpmn:documentation>Full name: Genuine risk?</bpmn:documentation><bpmn:incoming>Flow_RequestInformationFromProducer_To_GenuineRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_GenuineRisk_To_NoGenuineRisk</bpmn:outgoing>
    <bpmn:outgoing>Flow_GenuineRisk_To_Suspend</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="Marketplace_SuspendProductAndNotifyAffectedCustomers" name="Remove product, warn buyers">
      <bpmn:documentation>Full name: Suspend product and notify affected customers</bpmn:documentation><bpmn:incoming>Flow_GenuineRisk_To_Suspend</bpmn:incoming><bpmn:outgoing>Flow_SuspendProductAndNotifyAffectedCustomers_To_ReviewIncident</bpmn:outgoing>
      <bpmn:startEvent id="SuspendProductAndNotifyAffectedCustomers_RiskConfirmed" name="Risk confirmed">
        <bpmn:outgoing>Flow_RiskConfirmed_To_SuspendProductFromSale</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SuspendProductAndNotifyAffectedCustomers_SuspendProductFromSale" name="Suspend product from sale">
        <bpmn:incoming>Flow_RiskConfirmed_To_SuspendProductFromSale</bpmn:incoming>
        <bpmn:outgoing>Flow_SuspendProductFromSale_To_IdentifyAffectedCustomers</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SuspendProductAndNotifyAffectedCustomers_IdentifyAffectedCustomers" name="Identify affected customers">
        <bpmn:incoming>Flow_SuspendProductFromSale_To_IdentifyAffectedCustomers</bpmn:incoming>
        <bpmn:outgoing>Flow_IdentifyAffectedCustomers_To_SendSafetyNotifications</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SuspendProductAndNotifyAffectedCustomers_SendSafetyNotifications" name="Send safety notifications">
        <bpmn:incoming>Flow_IdentifyAffectedCustomers_To_SendSafetyNotifications</bpmn:incoming>
        <bpmn:outgoing>Flow_SendSafetyNotifications_To_RecordNotificationResults</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SuspendProductAndNotifyAffectedCustomers_RecordNotificationResults" name="Record notification results">
        <bpmn:incoming>Flow_SendSafetyNotifications_To_RecordNotificationResults</bpmn:incoming>
        <bpmn:outgoing>Flow_RecordNotificationResults_To_CustomersNotified</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SuspendProductAndNotifyAffectedCustomers_CustomersNotified" name="Customers notified">
        <bpmn:incoming>Flow_RecordNotificationResults_To_CustomersNotified</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_RiskConfirmed_To_SuspendProductFromSale" sourceRef="SuspendProductAndNotifyAffectedCustomers_RiskConfirmed" targetRef="SuspendProductAndNotifyAffectedCustomers_SuspendProductFromSale" />
      <bpmn:sequenceFlow id="Flow_SuspendProductFromSale_To_IdentifyAffectedCustomers" sourceRef="SuspendProductAndNotifyAffectedCustomers_SuspendProductFromSale" targetRef="SuspendProductAndNotifyAffectedCustomers_IdentifyAffectedCustomers" />
      <bpmn:sequenceFlow id="Flow_IdentifyAffectedCustomers_To_SendSafetyNotifications" sourceRef="SuspendProductAndNotifyAffectedCustomers_IdentifyAffectedCustomers" targetRef="SuspendProductAndNotifyAffectedCustomers_SendSafetyNotifications" />
      <bpmn:sequenceFlow id="Flow_SendSafetyNotifications_To_RecordNotificationResults" sourceRef="SuspendProductAndNotifyAffectedCustomers_SendSafetyNotifications" targetRef="SuspendProductAndNotifyAffectedCustomers_RecordNotificationResults" />
      <bpmn:sequenceFlow id="Flow_RecordNotificationResults_To_CustomersNotified" sourceRef="SuspendProductAndNotifyAffectedCustomers_RecordNotificationResults" targetRef="SuspendProductAndNotifyAffectedCustomers_CustomersNotified" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Marketplace_ReviewIncident" name="Check it's fixed">
      <bpmn:documentation>Full name: Review incident</bpmn:documentation><bpmn:incoming>Flow_SuspendProductAndNotifyAffectedCustomers_To_ReviewIncident</bpmn:incoming>
      <bpmn:startEvent id="ReviewIncident_ActionsComplete" name="Actions complete">
        <bpmn:outgoing>Flow_ActionsComplete_To_CheckAllActionsAreComplete</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="ReviewIncident_CheckAllActionsAreComplete" name="Check all actions are complete">
        <bpmn:incoming>Flow_ActionsComplete_To_CheckAllActionsAreComplete</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckAllActionsAreComplete_To_RecordReviewDecision</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="ReviewIncident_RecordReviewDecision" name="Record review decision">
        <bpmn:incoming>Flow_CheckAllActionsAreComplete_To_RecordReviewDecision</bpmn:incoming>
        <bpmn:outgoing>Flow_RecordReviewDecision_To_ReviewRecorded</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="ReviewIncident_ReviewRecorded" name="Review recorded">
        <bpmn:incoming>Flow_RecordReviewDecision_To_ReviewRecorded</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ActionsComplete_To_CheckAllActionsAreComplete" sourceRef="ReviewIncident_ActionsComplete" targetRef="ReviewIncident_CheckAllActionsAreComplete" />
      <bpmn:sequenceFlow id="Flow_CheckAllActionsAreComplete_To_RecordReviewDecision" sourceRef="ReviewIncident_CheckAllActionsAreComplete" targetRef="ReviewIncident_RecordReviewDecision" />
      <bpmn:sequenceFlow id="Flow_RecordReviewDecision_To_ReviewRecorded" sourceRef="ReviewIncident_RecordReviewDecision" targetRef="ReviewIncident_ReviewRecorded" />
    <bpmn:outgoing>Flow_ReviewIncident_To_IncidentClosed</bpmn:outgoing></bpmn:subProcess>
    <bpmn:endEvent id="Marketplace_IncidentClosed" name="Closed">
      <bpmn:documentation>Full name: Incident closed</bpmn:documentation><bpmn:incoming>Flow_ReviewIncident_To_IncidentClosed</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="Marketplace_NoGenuineRisk" name="No risk">
      <bpmn:documentation>Full name: No genuine risk</bpmn:documentation><bpmn:incoming>Flow_GenuineRisk_To_NoGenuineRisk</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Marketplace_ProducerApplicationReceived" name="Application in">
      <bpmn:documentation>Full name: Producer application received</bpmn:documentation><bpmn:outgoing>Flow_ProducerApplicationReceived_To_VerifyAndRegisterProducer</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Marketplace_ProducerApplicationReceived_MessageDefinition" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Marketplace_VerifyAndRegisterProducer" name="Check and sign up producer">
      <bpmn:documentation>Full name: Verify and register producer</bpmn:documentation><bpmn:incoming>Flow_ProducerApplicationReceived_To_VerifyAndRegisterProducer</bpmn:incoming>
      <bpmn:outgoing>Flow_VerifyAndRegisterProducer_To_ProducerRegistered</bpmn:outgoing>
      <bpmn:startEvent id="VerifyAndRegisterProducer_ApplicationReceived" name="Application received">
        <bpmn:outgoing>Flow_ApplicationReceived_To_CheckProducerDetails</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="VerifyAndRegisterProducer_CheckProducerDetails" name="Check producer details">
        <bpmn:incoming>Flow_ApplicationReceived_To_CheckProducerDetails</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckProducerDetails_To_CreateProducerAccount</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="VerifyAndRegisterProducer_CreateProducerAccount" name="Create producer account">
        <bpmn:incoming>Flow_CheckProducerDetails_To_CreateProducerAccount</bpmn:incoming>
        <bpmn:outgoing>Flow_CreateProducerAccount_To_AccountCreated</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="VerifyAndRegisterProducer_AccountCreated" name="Account created">
        <bpmn:incoming>Flow_CreateProducerAccount_To_AccountCreated</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ApplicationReceived_To_CheckProducerDetails" sourceRef="VerifyAndRegisterProducer_ApplicationReceived" targetRef="VerifyAndRegisterProducer_CheckProducerDetails" />
      <bpmn:sequenceFlow id="Flow_CheckProducerDetails_To_CreateProducerAccount" sourceRef="VerifyAndRegisterProducer_CheckProducerDetails" targetRef="VerifyAndRegisterProducer_CreateProducerAccount" />
      <bpmn:sequenceFlow id="Flow_CreateProducerAccount_To_AccountCreated" sourceRef="VerifyAndRegisterProducer_CreateProducerAccount" targetRef="VerifyAndRegisterProducer_AccountCreated" />
    </bpmn:subProcess>
    <bpmn:endEvent id="Marketplace_ProducerRegistered" name="Signed up">
      <bpmn:documentation>Full name: Producer registered</bpmn:documentation><bpmn:incoming>Flow_VerifyAndRegisterProducer_To_ProducerRegistered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Marketplace_ProductDetailsReceived" name="Product in">
      <bpmn:documentation>Full name: Product details received</bpmn:documentation><bpmn:outgoing>Flow_ProductDetailsReceived_To_ValidateProductDetails</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Marketplace_ProductDetailsReceived_MessageDefinition" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Marketplace_ValidateProductDetails" name="Check product">
      <bpmn:documentation>Full name: Validate product details</bpmn:documentation><bpmn:incoming>Flow_ProductDetailsReceived_To_ValidateProductDetails</bpmn:incoming>
      <bpmn:startEvent id="ValidateProductDetails_DetailsReceived" name="Details received">
        <bpmn:outgoing>Flow_DetailsReceived_To_CheckMandatoryInformation</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="ValidateProductDetails_CheckMandatoryInformation" name="Check mandatory information">
        <bpmn:incoming>Flow_DetailsReceived_To_CheckMandatoryInformation</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckMandatoryInformation_To_VerifyOrganicCertificateIfClaimed</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="ValidateProductDetails_VerifyOrganicCertificateIfClaimed" name="Verify organic certificate if claimed">
        <bpmn:incoming>Flow_CheckMandatoryInformation_To_VerifyOrganicCertificateIfClaimed</bpmn:incoming>
        <bpmn:outgoing>Flow_VerifyOrganicCertificateIfClaimed_To_ValidationFinished</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="ValidateProductDetails_ValidationFinished" name="Validation finished">
        <bpmn:incoming>Flow_VerifyOrganicCertificateIfClaimed_To_ValidationFinished</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_DetailsReceived_To_CheckMandatoryInformation" sourceRef="ValidateProductDetails_DetailsReceived" targetRef="ValidateProductDetails_CheckMandatoryInformation" />
      <bpmn:sequenceFlow id="Flow_CheckMandatoryInformation_To_VerifyOrganicCertificateIfClaimed" sourceRef="ValidateProductDetails_CheckMandatoryInformation" targetRef="ValidateProductDetails_VerifyOrganicCertificateIfClaimed" />
      <bpmn:sequenceFlow id="Flow_VerifyOrganicCertificateIfClaimed_To_ValidationFinished" sourceRef="ValidateProductDetails_VerifyOrganicCertificateIfClaimed" targetRef="ValidateProductDetails_ValidationFinished" />
    <bpmn:outgoing>Flow_ValidateProductDetails_To_DetailsValid</bpmn:outgoing></bpmn:subProcess>
    <bpmn:exclusiveGateway id="Marketplace_DetailsValid" name="OK?">
      <bpmn:documentation>Full name: Details valid?</bpmn:documentation><bpmn:incoming>Flow_ValidateProductDetails_To_DetailsValid</bpmn:incoming><bpmn:outgoing>Flow_DetailsValid_To_PublishProduct</bpmn:outgoing>
      <bpmn:outgoing>Flow_DetailsValid_To_CorrectionsRequested</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Marketplace_PublishProduct" name="Put on sale">
      <bpmn:documentation>Full name: Publish product</bpmn:documentation><bpmn:incoming>Flow_DetailsValid_To_PublishProduct</bpmn:incoming>
      <bpmn:outgoing>Flow_PublishProduct_To_ProductAvailable</bpmn:outgoing>
      <bpmn:startEvent id="PublishProduct_DetailsApproved" name="Details approved">
        <bpmn:outgoing>Flow_DetailsApproved_To_CreateProductListing</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="PublishProduct_CreateProductListing" name="Create product listing">
        <bpmn:incoming>Flow_DetailsApproved_To_CreateProductListing</bpmn:incoming>
        <bpmn:outgoing>Flow_CreateProductListing_To_MakeProductVisibleToCustomers</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="PublishProduct_MakeProductVisibleToCustomers" name="Make product visible to customers">
        <bpmn:incoming>Flow_CreateProductListing_To_MakeProductVisibleToCustomers</bpmn:incoming>
        <bpmn:outgoing>Flow_MakeProductVisibleToCustomers_To_ListingLive</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="PublishProduct_ListingLive" name="Listing live">
        <bpmn:incoming>Flow_MakeProductVisibleToCustomers_To_ListingLive</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_DetailsApproved_To_CreateProductListing" sourceRef="PublishProduct_DetailsApproved" targetRef="PublishProduct_CreateProductListing" />
      <bpmn:sequenceFlow id="Flow_CreateProductListing_To_MakeProductVisibleToCustomers" sourceRef="PublishProduct_CreateProductListing" targetRef="PublishProduct_MakeProductVisibleToCustomers" />
      <bpmn:sequenceFlow id="Flow_MakeProductVisibleToCustomers_To_ListingLive" sourceRef="PublishProduct_MakeProductVisibleToCustomers" targetRef="PublishProduct_ListingLive" />
    </bpmn:subProcess>
    <bpmn:endEvent id="Marketplace_ProductAvailable" name="On sale">
      <bpmn:documentation>Full name: Product available</bpmn:documentation><bpmn:incoming>Flow_PublishProduct_To_ProductAvailable</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Marketplace_CorrectionsRequested" name="Sent back to fix">
      <bpmn:documentation>Full name: Corrections requested</bpmn:documentation><bpmn:incoming>Flow_DetailsValid_To_CorrectionsRequested</bpmn:incoming>
      <bpmn:messageEventDefinition id="Marketplace_CorrectionsRequested_MessageDefinition" />
    </bpmn:endEvent>
    <bpmn:startEvent id="Marketplace_StockUpdateReceived" name="Stock change in">
      <bpmn:documentation>Full name: Stock update received</bpmn:documentation><bpmn:outgoing>Flow_StockUpdateReceived_To_UpdateStockAndAvailability</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Marketplace_StockUpdateReceived_MessageDefinition" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Marketplace_UpdateStockAndAvailability" name="Update stock">
      <bpmn:documentation>Full name: Update stock and availability</bpmn:documentation><bpmn:incoming>Flow_StockUpdateReceived_To_UpdateStockAndAvailability</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateStockAndAvailability_To_AvailabilityUpdated</bpmn:outgoing>
      <bpmn:startEvent id="UpdateStockAndAvailability_StockLevelReceived" name="Stock level received">
        <bpmn:outgoing>Flow_StockLevelReceived_To_RecordNewStockLevel</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="UpdateStockAndAvailability_RecordNewStockLevel" name="Record new stock level">
        <bpmn:incoming>Flow_StockLevelReceived_To_RecordNewStockLevel</bpmn:incoming>
        <bpmn:outgoing>Flow_RecordNewStockLevel_To_SetAvailabilityFromStockAndSeason</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="UpdateStockAndAvailability_SetAvailabilityFromStockAndSeason" name="Set availability from stock and season">
        <bpmn:incoming>Flow_RecordNewStockLevel_To_SetAvailabilityFromStockAndSeason</bpmn:incoming>
        <bpmn:outgoing>Flow_SetAvailabilityFromStockAndSeason_To_AvailabilitySet</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="UpdateStockAndAvailability_AvailabilitySet" name="Availability set">
        <bpmn:incoming>Flow_SetAvailabilityFromStockAndSeason_To_AvailabilitySet</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_StockLevelReceived_To_RecordNewStockLevel" sourceRef="UpdateStockAndAvailability_StockLevelReceived" targetRef="UpdateStockAndAvailability_RecordNewStockLevel" />
      <bpmn:sequenceFlow id="Flow_RecordNewStockLevel_To_SetAvailabilityFromStockAndSeason" sourceRef="UpdateStockAndAvailability_RecordNewStockLevel" targetRef="UpdateStockAndAvailability_SetAvailabilityFromStockAndSeason" />
      <bpmn:sequenceFlow id="Flow_SetAvailabilityFromStockAndSeason_To_AvailabilitySet" sourceRef="UpdateStockAndAvailability_SetAvailabilityFromStockAndSeason" targetRef="UpdateStockAndAvailability_AvailabilitySet" />
    </bpmn:subProcess>
    <bpmn:endEvent id="Marketplace_AvailabilityUpdated" name="Stock updated">
      <bpmn:documentation>Full name: Availability updated</bpmn:documentation><bpmn:incoming>Flow_UpdateStockAndAvailability_To_AvailabilityUpdated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Marketplace_EveryWeek" name="Every week"><bpmn:documentation>Case study, Producers: 'weekly payment settlements with transparent audit trails'. Timer cycle R/P7D (every 7 days).</bpmn:documentation><bpmn:outgoing>Flow_EveryWeek_To_PayProducersWeekly</bpmn:outgoing><bpmn:timerEventDefinition id="Marketplace_EveryWeek_Timer"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P7D</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent><bpmn:subProcess id="Marketplace_PayProducersWeekly" name="Pay producers"><bpmn:documentation>Case study context: distribute payments to producers 'according to agreed timeframes' with an audit trail for tax reporting. Pays the amounts already worked out per order in Payment &amp; Order Processing (a GBP 100 sale pays the producer GBP 95; the 5% commission is not taken a second time).
Full name: Pay producers weekly</bpmn:documentation><bpmn:outgoing>Flow_PayProducersWeekly_To_ProducersPaid</bpmn:outgoing><bpmn:incoming>Flow_EveryWeek_To_PayProducersWeekly</bpmn:incoming><bpmn:property id="Property_PayProducersWeekly" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="PayProducersWeekly_Reads_OrderCustomerAndProducerRecords"><bpmn:sourceRef>OrderCustomerAndProducerRecords_Settlement</bpmn:sourceRef><bpmn:targetRef>Property_PayProducersWeekly</bpmn:targetRef></bpmn:dataInputAssociation><bpmn:startEvent id="PayProducers_WeekEnded" name="Week ended"><bpmn:outgoing>Flow_PayProducers_WeekEnded_To_PayProducers_AddUpAmounts</bpmn:outgoing></bpmn:startEvent><bpmn:task id="PayProducers_AddUpAmounts" name="Add up what each producer is owed"><bpmn:outgoing>Flow_PayProducers_AddUpAmounts_To_PayProducers_SendPayments</bpmn:outgoing><bpmn:incoming>Flow_PayProducers_WeekEnded_To_PayProducers_AddUpAmounts</bpmn:incoming></bpmn:task><bpmn:task id="PayProducers_SendPayments" name="Send payments through payment service"><bpmn:outgoing>Flow_PayProducers_SendPayments_To_PayProducers_RecordStatement</bpmn:outgoing><bpmn:incoming>Flow_PayProducers_AddUpAmounts_To_PayProducers_SendPayments</bpmn:incoming></bpmn:task><bpmn:task id="PayProducers_RecordStatement" name="Record payment statement"><bpmn:outgoing>Flow_PayProducers_RecordStatement_To_PayProducers_Done</bpmn:outgoing><bpmn:incoming>Flow_PayProducers_SendPayments_To_PayProducers_RecordStatement</bpmn:incoming></bpmn:task><bpmn:endEvent id="PayProducers_Done" name="Producers paid"><bpmn:incoming>Flow_PayProducers_RecordStatement_To_PayProducers_Done</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_PayProducers_WeekEnded_To_PayProducers_AddUpAmounts" sourceRef="PayProducers_WeekEnded" targetRef="PayProducers_AddUpAmounts" /><bpmn:sequenceFlow id="Flow_PayProducers_AddUpAmounts_To_PayProducers_SendPayments" sourceRef="PayProducers_AddUpAmounts" targetRef="PayProducers_SendPayments" /><bpmn:sequenceFlow id="Flow_PayProducers_SendPayments_To_PayProducers_RecordStatement" sourceRef="PayProducers_SendPayments" targetRef="PayProducers_RecordStatement" /><bpmn:sequenceFlow id="Flow_PayProducers_RecordStatement_To_PayProducers_Done" sourceRef="PayProducers_RecordStatement" targetRef="PayProducers_Done" /></bpmn:subProcess><bpmn:endEvent id="Marketplace_ProducersPaid" name="Producers paid"><bpmn:documentation>Weekly payments sent and recorded.</bpmn:documentation><bpmn:incoming>Flow_PayProducersWeekly_To_ProducersPaid</bpmn:incoming></bpmn:endEvent><bpmn:dataStoreReference id="OrderCustomerAndProducerRecords_Settlement" name="Orders" dataStoreRef="DataStore_Orders"><bpmn:documentation>Full name: Order, customer &amp; producer records</bpmn:documentation></bpmn:dataStoreReference><bpmn:startEvent id="Marketplace_OfferOrRecipeReceived" name="Offer in"><bpmn:documentation>Case study: surplus produce communication with last-minute discounts; seasonal recipes, storage guidance and farm stories.
Full name: Offer or recipe received</bpmn:documentation><bpmn:outgoing>Flow_OfferOrRecipeReceived_To_ShareOffersAndRecipes</bpmn:outgoing><bpmn:messageEventDefinition id="Marketplace_OfferOrRecipeReceived_Msg" /></bpmn:startEvent><bpmn:task id="Marketplace_ShareOffersAndRecipes" name="Share offers &amp; recipes"><bpmn:documentation>Case study context: send surplus offers (last-minute discounts to reduce food waste) and educational content to customers.
Full name: Share offers and recipes</bpmn:documentation><bpmn:outgoing>Flow_ShareOffersAndRecipes_To_CustomersInformed</bpmn:outgoing><bpmn:incoming>Flow_OfferOrRecipeReceived_To_ShareOffersAndRecipes</bpmn:incoming></bpmn:task><bpmn:endEvent id="Marketplace_CustomersInformed" name="Customers told"><bpmn:documentation>Offers or recipes shared with customers.
Full name: Customers informed</bpmn:documentation><bpmn:incoming>Flow_ShareOffersAndRecipes_To_CustomersInformed</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_CustomerStartsShopping_To_FindProducts" sourceRef="Marketplace_CustomerStartsShopping" targetRef="Marketplace_FindProducts" />
    <bpmn:sequenceFlow id="Flow_FindProducts_To_CheckoutAndStockValidation" sourceRef="Marketplace_FindProducts" targetRef="Marketplace_CheckoutAndStockValidation" />
    <bpmn:sequenceFlow id="Flow_CheckoutAndStockValidation_To_PaymentAndOrderProcessing" sourceRef="Marketplace_CheckoutAndStockValidation" targetRef="Marketplace_PaymentAndOrderProcessing" />
    <bpmn:sequenceFlow id="Flow_PaymentAndOrderProcessing_To_CoordinateDeliveryOrCollection" sourceRef="Marketplace_PaymentAndOrderProcessing" targetRef="Marketplace_CoordinateDeliveryOrCollection" />
    <bpmn:sequenceFlow id="Flow_CoordinateDeliveryOrCollection_To_OrderComplete" sourceRef="Marketplace_CoordinateDeliveryOrCollection" targetRef="Marketplace_OrderComplete" />
    <bpmn:sequenceFlow id="Flow_CheckoutCancelledOrTimedOut_To_CheckoutAbandoned" sourceRef="Marketplace_CheckoutCancelledOrTimedOut" targetRef="Marketplace_CheckoutAbandoned" />
    <bpmn:sequenceFlow id="Flow_PaymentFailedAfterRetries_To_OrderNotPlaced" sourceRef="Marketplace_PaymentFailedAfterRetries" targetRef="Marketplace_OrderNotPlaced" />
    <bpmn:sequenceFlow id="Flow_FoodProblemReported_To_RecordIncidentAndIdentifyProduct" sourceRef="Marketplace_FoodProblemReported" targetRef="Marketplace_RecordIncidentAndIdentifyProduct" />
    <bpmn:sequenceFlow id="Flow_RecordIncidentAndIdentifyProduct_To_RequestInformationFromProducer" sourceRef="Marketplace_RecordIncidentAndIdentifyProduct" targetRef="Marketplace_RequestInformationFromProducer" />
    <bpmn:sequenceFlow id="Flow_RequestInformationFromProducer_To_GenuineRisk" sourceRef="Marketplace_RequestInformationFromProducer" targetRef="Marketplace_GenuineRisk" />
    <bpmn:sequenceFlow id="Flow_SuspendProductAndNotifyAffectedCustomers_To_ReviewIncident" sourceRef="Marketplace_SuspendProductAndNotifyAffectedCustomers" targetRef="Marketplace_ReviewIncident" />
    <bpmn:sequenceFlow id="Flow_GenuineRisk_To_NoGenuineRisk" name="No" sourceRef="Marketplace_GenuineRisk" targetRef="Marketplace_NoGenuineRisk" />
    <bpmn:sequenceFlow id="Flow_ProducerApplicationReceived_To_VerifyAndRegisterProducer" sourceRef="Marketplace_ProducerApplicationReceived" targetRef="Marketplace_VerifyAndRegisterProducer" />
    <bpmn:sequenceFlow id="Flow_VerifyAndRegisterProducer_To_ProducerRegistered" sourceRef="Marketplace_VerifyAndRegisterProducer" targetRef="Marketplace_ProducerRegistered" />
    <bpmn:sequenceFlow id="Flow_ProductDetailsReceived_To_ValidateProductDetails" sourceRef="Marketplace_ProductDetailsReceived" targetRef="Marketplace_ValidateProductDetails" />
    <bpmn:sequenceFlow id="Flow_DetailsValid_To_PublishProduct" name="Yes" sourceRef="Marketplace_DetailsValid" targetRef="Marketplace_PublishProduct" />
    <bpmn:sequenceFlow id="Flow_PublishProduct_To_ProductAvailable" sourceRef="Marketplace_PublishProduct" targetRef="Marketplace_ProductAvailable" />
    <bpmn:sequenceFlow id="Flow_DetailsValid_To_CorrectionsRequested" name="No" sourceRef="Marketplace_DetailsValid" targetRef="Marketplace_CorrectionsRequested" />
    <bpmn:sequenceFlow id="Flow_StockUpdateReceived_To_UpdateStockAndAvailability" sourceRef="Marketplace_StockUpdateReceived" targetRef="Marketplace_UpdateStockAndAvailability" />
    <bpmn:sequenceFlow id="Flow_UpdateStockAndAvailability_To_AvailabilityUpdated" sourceRef="Marketplace_UpdateStockAndAvailability" targetRef="Marketplace_AvailabilityUpdated" />
    <bpmn:dataStoreReference id="ProductAndStockRecords_Checkout" name="Products" dataStoreRef="DataStore_Products"><bpmn:documentation>Full name: Product &amp; stock records</bpmn:documentation></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="OrderCustomerAndProducerRecords_OrderProcessing" name="Orders" dataStoreRef="DataStore_Orders"><bpmn:documentation>Full name: Order, customer &amp; producer records</bpmn:documentation></bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="ProductAndStockRecords_OrderProcessing" name="Products" dataStoreRef="DataStore_Products"><bpmn:documentation>Full name: Product &amp; stock records</bpmn:documentation></bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="Flow_EveryWeek_To_PayProducersWeekly" sourceRef="Marketplace_EveryWeek" targetRef="Marketplace_PayProducersWeekly" /><bpmn:sequenceFlow id="Flow_PayProducersWeekly_To_ProducersPaid" sourceRef="Marketplace_PayProducersWeekly" targetRef="Marketplace_ProducersPaid" /><bpmn:sequenceFlow id="Flow_OfferOrRecipeReceived_To_ShareOffersAndRecipes" sourceRef="Marketplace_OfferOrRecipeReceived" targetRef="Marketplace_ShareOffersAndRecipes" /><bpmn:sequenceFlow id="Flow_ShareOffersAndRecipes_To_CustomersInformed" sourceRef="Marketplace_ShareOffersAndRecipes" targetRef="Marketplace_CustomersInformed" /><bpmn:sequenceFlow id="Flow_GenuineRisk_To_Suspend" sourceRef="Marketplace_GenuineRisk" targetRef="Marketplace_SuspendProductAndNotifyAffectedCustomers" name="Yes" /><bpmn:sequenceFlow id="Flow_ReviewIncident_To_IncidentClosed" sourceRef="Marketplace_ReviewIncident" targetRef="Marketplace_IncidentClosed" /><bpmn:sequenceFlow id="Flow_ValidateProductDetails_To_DetailsValid" sourceRef="Marketplace_ValidateProductDetails" targetRef="Marketplace_DetailsValid" /></bpmn:process>
  <bpmn:process id="Process_Producer" name="Registered Producer" isExecutable="false">
    <bpmn:startEvent id="Producer_ProducerOrderReceived" name="New order">
      <bpmn:documentation>Full name: Producer order received</bpmn:documentation><bpmn:outgoing>Flow_ProducerOrderReceived_To_PrepareOrderItems</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Producer_ProducerOrderReceived_MessageDefinition" />
    </bpmn:startEvent>
    <bpmn:task id="Producer_PrepareOrderItems" name="Prepare order">
      <bpmn:documentation>Full name: Prepare order items</bpmn:documentation><bpmn:incoming>Flow_ProducerOrderReceived_To_PrepareOrderItems</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareOrderItems_To_OrderReady</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Producer_OrderReady" name="Ready">
      <bpmn:documentation>Full name: Order ready</bpmn:documentation><bpmn:incoming>Flow_PrepareOrderItems_To_OrderReady</bpmn:incoming>
      <bpmn:messageEventDefinition id="Producer_OrderReady_MessageDefinition" />
    </bpmn:endEvent>
    <bpmn:startEvent id="Producer_WantsToListAProduct" name="New product">
      <bpmn:documentation>Full name: Wants to list a product</bpmn:documentation><bpmn:outgoing>Flow_WantsToListAProduct_To_SubmitProductDetails</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="Producer_WantsToListAProduct_ConditionDefinition"><bpmn:condition xsi:type="bpmn:tFormalExpression" /></bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="Producer_SubmitProductDetails" name="Send product details">
      <bpmn:documentation>Full name: Submit product details</bpmn:documentation><bpmn:incoming>Flow_WantsToListAProduct_To_SubmitProductDetails</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitProductDetails_To_ListingSubmitted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Producer_ListingSubmitted" name="Sent">
      <bpmn:documentation>Full name: Listing submitted</bpmn:documentation><bpmn:incoming>Flow_SubmitProductDetails_To_ListingSubmitted</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Producer_StockLevelChanges" name="Stock changes">
      <bpmn:documentation>Full name: Stock level changes</bpmn:documentation><bpmn:outgoing>Flow_StockLevelChanges_To_UpdateStockLevels</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="Producer_StockLevelChanges_ConditionDefinition"><bpmn:condition xsi:type="bpmn:tFormalExpression" /></bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="Producer_UpdateStockLevels" name="Update stock">
      <bpmn:documentation>Full name: Update stock levels</bpmn:documentation><bpmn:incoming>Flow_StockLevelChanges_To_UpdateStockLevels</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateStockLevels_To_StockUpdated</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Producer_StockUpdated" name="Sent">
      <bpmn:documentation>Full name: Stock updated</bpmn:documentation><bpmn:incoming>Flow_UpdateStockLevels_To_StockUpdated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Producer_WantsToSellFood" name="Wants to sell">
      <bpmn:documentation>Full name: Wants to sell food</bpmn:documentation><bpmn:outgoing>Flow_WantsToSellFood_To_ApplyToSell</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Producer_ApplyToSell" name="Apply to sell">
      <bpmn:incoming>Flow_WantsToSellFood_To_ApplyToSell</bpmn:incoming>
      <bpmn:outgoing>Flow_ApplyToSell_To_ApplicationSent</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Producer_ApplicationSent" name="Applied">
      <bpmn:documentation>Full name: Application sent</bpmn:documentation><bpmn:incoming>Flow_ApplyToSell_To_ApplicationSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Producer_FindsAQualityProblem" name="Finds a problem">
      <bpmn:documentation>Full name: Finds a quality problem</bpmn:documentation><bpmn:outgoing>Flow_FindsAQualityProblem_To_ReportProblem</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="Producer_FindsAQualityProblem_ConditionDefinition"><bpmn:condition xsi:type="bpmn:tFormalExpression" /></bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="Producer_ReportProblem" name="Report problem">
      <bpmn:incoming>Flow_FindsAQualityProblem_To_ReportProblem</bpmn:incoming>
      <bpmn:outgoing>Flow_ReportProblem_To_ProblemReported2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Producer_ProblemReported" name="Problem reported">
      <bpmn:incoming>Flow_ReportProblem_To_ProblemReported2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Producer_InformationRequested" name="Asked a question">
      <bpmn:documentation>Full name: Information requested</bpmn:documentation><bpmn:outgoing>Flow_InformationRequested_To_ProvideProductInformation</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Producer_InformationRequested_MessageDefinition" />
    </bpmn:startEvent>
    <bpmn:task id="Producer_ProvideProductInformation" name="Answer">
      <bpmn:documentation>Full name: Provide product information</bpmn:documentation><bpmn:incoming>Flow_InformationRequested_To_ProvideProductInformation</bpmn:incoming>
