    <bpmn:sequenceFlow id="Flow_0kxfotj" sourceRef="Task_AmendBasket" targetRef="Gateway_1nhn4f7" />
    <bpmn:serviceTask id="Task_CheckStock" name="Check stock for each item" implementation="##WebService">
      <bpmn:extensionElements>
        <zeebe:taskDefinition />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0zkfq9z</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_StockCheck" name="All items in stock?">
