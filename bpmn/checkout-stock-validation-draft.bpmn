      <bpmn:outgoing>Flow_123qy1x</bpmn:outgoing>
      <bpmn:outgoing>Flow_1ry4lcq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_InformCustomer" name="Inform customer of stock issue" implementation="##WebService">
      <bpmn:incoming>Flow_123qy1x</bpmn:incoming>
      <bpmn:outgoing>Flow_1hzu8qo</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_IdentifyProducers" name="Identify producers involved" implementation="##WebService">
      <bpmn:incoming>Flow_1ry4lcq</bpmn:incoming>
      <bpmn:outgoing>Flow_To_DetermineArrangements</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_AmendBasket" name="Amend basket" implementation="##unspecified">
      <bpmn:incoming>Flow_1hzu8qo</bpmn:incoming>
      <bpmn:outgoing>Flow_0kxfotj</bpmn:outgoing>
