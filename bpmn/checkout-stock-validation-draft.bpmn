  <bpmn:process id="Process_Checkout" processType="None" isClosed="false" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_01jzsz8" name="Customer">
        <bpmn:flowNodeRef>StartEvent_Checkout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AmendBasket</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0zkrqsw" name="Platform">
        <bpmn:flowNodeRef>EndEvent_ReadyForPayment</bpmn:flowNodeRef>
