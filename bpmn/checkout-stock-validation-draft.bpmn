    <bpmn:exclusiveGateway id="Gateway_1nhn4f7">
      <bpmn:incoming>Flow_17a11jo</bpmn:incoming>
      <bpmn:incoming>Flow_0kxfotj</bpmn:incoming>
      <bpmn:outgoing>Flow_0zkfq9z</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_01vppj0" sourceRef="Task_ConfirmOrder" targetRef="EndEvent_ReadyForPayment" />
    <bpmn:serviceTask id="Task_DetermineArrangements" name="Determine delivery or collection arrangements" implementation="##WebService">
      <bpmn:incoming>Flow_To_DetermineArrangements</bpmn:incoming>
      <bpmn:outgoing>Flow_To_ConfirmOrder</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
