        <bpmn:flowNodeRef>Task_DetermineArrangements</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:endEvent id="EndEvent_ReadyForPayment" name="Order ready for payment">
      <bpmn:incoming>Flow_01vppj0</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_To_ConfirmOrder" sourceRef="Task_DetermineArrangements" targetRef="Task_ConfirmOrder" />
    <bpmn:sequenceFlow id="Flow_To_DetermineArrangements" sourceRef="Task_IdentifyProducers" targetRef="Task_DetermineArrangements" />
    <bpmn:sequenceFlow id="Flow_1ry4lcq" name="Yes" sourceRef="Gateway_StockCheck" targetRef="Task_IdentifyProducers" />
    <bpmn:sequenceFlow id="Flow_To_Gateway" sourceRef="Task_CheckStock" targetRef="Gateway_StockCheck" />
    <bpmn:sequenceFlow id="Flow_123qy1x" name="No" sourceRef="Gateway_StockCheck" targetRef="Task_InformCustomer" />
    <bpmn:sequenceFlow id="Flow_1hzu8qo" sourceRef="Task_InformCustomer" targetRef="Task_AmendBasket" />
    <bpmn:startEvent id="StartEvent_Checkout" name="Customer proceeds to checkout">
      <bpmn:outgoing>Flow_17a11jo</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ConfirmOrder" name="Review and confirm order" implementation="##unspecified">
      <bpmn:incoming>Flow_To_ConfirmOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_01vppj0</bpmn:outgoing>
    </bpmn:userTask>
