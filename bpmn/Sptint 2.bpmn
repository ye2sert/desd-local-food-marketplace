<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_TeacherFeedback_UC2" targetNamespace="https://uwe.ac.uk/local-food-marketplace/uc2" exporter="Camunda Web Modeler" exporterVersion="64767e4" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:documentation>Teacher feedback revision: clear order delivery/collection, payment decline with alternative payment method (not restart), explicit participant pools and responsibility lanes. Producer workflow kept as external black box; project focus Use Case 2.</bpmn:documentation>
  <bpmn:collaboration id="Collaboration_UC2_TeacherFeedback" name="Sptint 2">
    <bpmn:participant id="Pool_Customer" name="Customer" processRef="Proc_Customer" />
    <bpmn:participant id="Pool_Gateway" name="Payment gateway (sandbox)" />
    <bpmn:participant id="Pool_Market" name="Local Food Marketplace" processRef="Proc_Market" />
    <bpmn:participant id="Pool_Producer" name="Local producers (external)" />
    <bpmn:messageFlow id="MF_01" name="Basket" sourceRef="C_submit" targetRef="M_start" />
    <bpmn:messageFlow id="MF_02" name="Revised basket" sourceRef="C_resubmit" targetRef="M_revised" />
    <bpmn:messageFlow id="MF_03" name="Stock issue" sourceRef="M_shortage" targetRef="C_stockresult" />
    <bpmn:messageFlow id="MF_04" name="Order / delivery options" sourceRef="M_summary" targetRef="C_stockresult" />
    <bpmn:messageFlow id="MF_05" name="Confirm + delivery choice" sourceRef="C_confirm" targetRef="M_choice" />
    <bpmn:messageFlow id="MF_06" name="Cancel" sourceRef="C_cancel" targetRef="M_choice" />
    <bpmn:messageFlow id="MF_07" name="Payment details" sourceRef="C_pay" targetRef="M_paydetails" />
    <bpmn:messageFlow id="MF_08" name="Payment request" sourceRef="M_charge" targetRef="Pool_Gateway" />
    <bpmn:messageFlow id="MF_09" name="Approved / declined" sourceRef="Pool_Gateway" targetRef="M_gateway_result" />
    <bpmn:messageFlow id="MF_10" name="Payment approved" sourceRef="M_paid_notice" targetRef="C_result" />
    <bpmn:messageFlow id="MF_11" name="Payment declined" sourceRef="M_declined" targetRef="C_result" />
    <bpmn:messageFlow id="MF_12" name="New payment method" sourceRef="C_newmethod" targetRef="M_retryrecv" />
    <bpmn:messageFlow id="MF_13" name="Stop payment" sourceRef="C_stopPay" targetRef="M_retryrecv" />
    <bpmn:messageFlow id="MF_14" name="Producer-specific order details" sourceRef="M_notify" targetRef="Pool_Producer" />
    <bpmn:messageFlow id="MF_15" name="Ready for handover" sourceRef="Pool_Producer" targetRef="M_ready" />
    <bpmn:messageFlow id="MF_16" name="Delivery / collection details" sourceRef="M_notify_customer" targetRef="C_fulfil_notice" />
    <bpmn:messageFlow id="MF_17" name="Status pending" sourceRef="M_pending_notice" targetRef="C_result" />
    <bpmn:messageFlow id="MF_18" name="Status enquiry" sourceRef="M_check_payment_status" targetRef="Pool_Gateway" />
    <bpmn:messageFlow id="MF_19" name="Status response" sourceRef="Pool_Gateway" targetRef="M_check_payment_status" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Customer" name="Customer ordering journey" isExecutable="false">
    <bpmn:startEvent id="C_start" name="Shop for local food">
      <bpmn:outgoing>SF_C_start_C_browse</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="C_browse" name="Browse products">
      <bpmn:incoming>SF_C_start_C_browse</bpmn:incoming>
      <bpmn:outgoing>SF_C_browse_C_basket</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C_basket" name="Add to basket">
      <bpmn:incoming>SF_C_browse_C_basket</bpmn:incoming>
      <bpmn:outgoing>SF_C_basket_C_submit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C_submit" name="Send basket">
      <bpmn:incoming>SF_C_basket_C_submit</bpmn:incoming>
      <bpmn:outgoing>SF_C_submit_C_stockresult</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Join_C_StockResult">
      <bpmn:documentation>XOR merge: the customer can get a stock result after the initial basket or after editing and resubmitting it. These routes are alternative, not parallel.</bpmn:documentation>
      <bpmn:incoming>SF_C_submit_C_stockresult</bpmn:incoming>
      <bpmn:incoming>SF_C_resubmit_C_stockresult</bpmn:incoming>
      <bpmn:outgoing>SF_Join_C_StockResult</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="C_stockresult" name="Stock result">
      <bpmn:incoming>SF_Join_C_StockResult</bpmn:incoming>
      <bpmn:outgoing>SF_C_stockresult_C_stockgw</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_stockresult_MessageEventDef" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="C_stockgw" name="Available?">
      <bpmn:incoming>SF_C_stockresult_C_stockgw</bpmn:incoming>
      <bpmn:outgoing>SF_C_stockgw_C_amend</bpmn:outgoing>
      <bpmn:outgoing>SF_C_stockgw_C_method</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="C_amend" name="Edit basket">
      <bpmn:incoming>SF_C_stockgw_C_amend</bpmn:incoming>
      <bpmn:outgoing>SF_C_amend_C_resubmit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C_resubmit" name="Resubmit basket">
      <bpmn:incoming>SF_C_amend_C_resubmit</bpmn:incoming>
      <bpmn:outgoing>SF_C_resubmit_C_stockresult</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C_method" name="Choose offered delivery or collection">
      <bpmn:incoming>SF_C_stockgw_C_method</bpmn:incoming>
      <bpmn:outgoing>SF_C_method_C_review</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C_review" name="Review order">
      <bpmn:incoming>SF_C_method_C_review</bpmn:incoming>
      <bpmn:outgoing>SF_C_review_C_confirmgw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="C_confirmgw" name="Confirm?">
      <bpmn:incoming>SF_C_review_C_confirmgw</bpmn:incoming>
      <bpmn:outgoing>SF_C_confirmgw_C_confirm</bpmn:outgoing>
      <bpmn:outgoing>SF_C_confirmgw_C_cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="C_confirm" name="Confirm order">
      <bpmn:incoming>SF_C_confirmgw_C_confirm</bpmn:incoming>
      <bpmn:outgoing>SF_C_confirm_C_pay</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C_cancel" name="Cancel checkout">
      <bpmn:incoming>SF_C_confirmgw_C_cancel</bpmn:incoming>
      <bpmn:outgoing>SF_C_cancel_C_cancelEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="C_cancelEnd" name="Checkout stopped">
      <bpmn:incoming>SF_C_cancel_C_cancelEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Join_C_PayDetails">
      <bpmn:documentation>XOR merge: reach payment entry after confirming checkout or after choosing a different payment method. Retains the basket and existing order.</bpmn:documentation>
      <bpmn:incoming>SF_C_confirm_C_pay</bpmn:incoming>
      <bpmn:incoming>SF_C_newmethod_C_pay</bpmn:incoming>
      <bpmn:outgoing>SF_Join_C_PayDetails</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="C_pay" name="Enter payment details">
      <bpmn:incoming>SF_Join_C_PayDetails</bpmn:incoming>
      <bpmn:outgoing>SF_C_pay_C_result</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="C_result" name="Payment result">
      <bpmn:incoming>SF_C_pay_C_result</bpmn:incoming>
      <bpmn:outgoing>SF_C_result_C_paidgw</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_result_MessageEventDef" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="C_paidgw" name="Payment status?">
      <bpmn:incoming>SF_C_result_C_paidgw</bpmn:incoming>
      <bpmn:outgoing>SF_C_paidgw_C_fulfil_notice</bpmn:outgoing>
      <bpmn:outgoing>SF_C_paidgw_C_retrygw</bpmn:outgoing>
      <bpmn:outgoing>SF_C_paidgw_C_pending</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="C_fulfil_notice" name="Delivery / collection details">
      <bpmn:incoming>SF_C_paidgw_C_fulfil_notice</bpmn:incoming>
      <bpmn:outgoing>SF_C_fulfil_notice_C_receive</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_fulfil_notice_MessageEventDef" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="C_receive" name="Receive or collect food">
      <bpmn:incoming>SF_C_fulfil_notice_C_receive</bpmn:incoming>
      <bpmn:outgoing>SF_C_receive_C_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="C_end" name="Order received">
      <bpmn:incoming>SF_C_receive_C_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="C_retrygw" name="Try another method?">
      <bpmn:incoming>SF_C_paidgw_C_retrygw</bpmn:incoming>
      <bpmn:outgoing>SF_C_retrygw_C_newmethod</bpmn:outgoing>
      <bpmn:outgoing>SF_C_retrygw_C_stopPay</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="C_newmethod" name="Use different payment method">
      <bpmn:incoming>SF_C_retrygw_C_newmethod</bpmn:incoming>
      <bpmn:outgoing>SF_C_newmethod_C_pay</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C_stopPay" name="Stop payment">
      <bpmn:incoming>SF_C_retrygw_C_stopPay</bpmn:incoming>
      <bpmn:outgoing>SF_C_stopPay_C_noorder</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="C_noorder" name="No paid order">
      <bpmn:incoming>SF_C_stopPay_C_noorder</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_C_start_C_browse" sourceRef="C_start" targetRef="C_browse" />
    <bpmn:sequenceFlow id="SF_C_browse_C_basket" sourceRef="C_browse" targetRef="C_basket" />
    <bpmn:sequenceFlow id="SF_C_basket_C_submit" sourceRef="C_basket" targetRef="C_submit" />
    <bpmn:sequenceFlow id="SF_Join_C_StockResult" sourceRef="Join_C_StockResult" targetRef="C_stockresult" />
    <bpmn:sequenceFlow id="SF_C_submit_C_stockresult" sourceRef="C_submit" targetRef="Join_C_StockResult" />
    <bpmn:sequenceFlow id="SF_C_stockresult_C_stockgw" sourceRef="C_stockresult" targetRef="C_stockgw" />
    <bpmn:sequenceFlow id="SF_C_stockgw_C_amend" name="No" sourceRef="C_stockgw" targetRef="C_amend" />
    <bpmn:sequenceFlow id="SF_C_amend_C_resubmit" sourceRef="C_amend" targetRef="C_resubmit" />
    <bpmn:sequenceFlow id="SF_C_resubmit_C_stockresult" sourceRef="C_resubmit" targetRef="Join_C_StockResult" />
    <bpmn:sequenceFlow id="SF_C_stockgw_C_method" name="Yes" sourceRef="C_stockgw" targetRef="C_method" />
    <bpmn:sequenceFlow id="SF_C_method_C_review" sourceRef="C_method" targetRef="C_review" />
    <bpmn:sequenceFlow id="SF_C_review_C_confirmgw" sourceRef="C_review" targetRef="C_confirmgw" />
    <bpmn:sequenceFlow id="SF_C_confirmgw_C_confirm" name="Yes" sourceRef="C_confirmgw" targetRef="C_confirm" />
    <bpmn:sequenceFlow id="SF_C_confirmgw_C_cancel" name="No" sourceRef="C_confirmgw" targetRef="C_cancel" />
    <bpmn:sequenceFlow id="SF_C_cancel_C_cancelEnd" sourceRef="C_cancel" targetRef="C_cancelEnd" />
    <bpmn:sequenceFlow id="SF_Join_C_PayDetails" sourceRef="Join_C_PayDetails" targetRef="C_pay" />
    <bpmn:sequenceFlow id="SF_C_confirm_C_pay" sourceRef="C_confirm" targetRef="Join_C_PayDetails" />
    <bpmn:sequenceFlow id="SF_C_pay_C_result" sourceRef="C_pay" targetRef="C_result" />
    <bpmn:sequenceFlow id="SF_C_result_C_paidgw" sourceRef="C_result" targetRef="C_paidgw" />
    <bpmn:sequenceFlow id="SF_C_paidgw_C_fulfil_notice" name="Yes" sourceRef="C_paidgw" targetRef="C_fulfil_notice" />
    <bpmn:sequenceFlow id="SF_C_fulfil_notice_C_receive" sourceRef="C_fulfil_notice" targetRef="C_receive" />
    <bpmn:sequenceFlow id="SF_C_receive_C_end" sourceRef="C_receive" targetRef="C_end" />
    <bpmn:sequenceFlow id="SF_C_paidgw_C_retrygw" name="No" sourceRef="C_paidgw" targetRef="C_retrygw" />
    <bpmn:sequenceFlow id="SF_C_retrygw_C_newmethod" name="Yes" sourceRef="C_retrygw" targetRef="C_newmethod" />
    <bpmn:sequenceFlow id="SF_C_retrygw_C_stopPay" name="No" sourceRef="C_retrygw" targetRef="C_stopPay" />
    <bpmn:sequenceFlow id="SF_C_newmethod_C_pay" sourceRef="C_newmethod" targetRef="Join_C_PayDetails" />
    <bpmn:sequenceFlow id="SF_C_stopPay_C_noorder" sourceRef="C_stopPay" targetRef="C_noorder" />
    <bpmn:task id="C_pending_status" name="Payment being checked">
      <bpmn:documentation>An unknown payment outcome is not a decline. Customer is told the payment is pending verification and should not blindly pay again.</bpmn:documentation>
      <bpmn:incoming>SF_C_paidgw_C_pending</bpmn:incoming>
      <bpmn:outgoing>SF_C_pending_C_pending_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="C_pending_end" name="Wait for update">
      <bpmn:documentation>A later update and reconciliation will be designed in the operational payment BPMN.</bpmn:documentation>
      <bpmn:incoming>SF_C_pending_C_pending_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_C_paidgw_C_pending" name="Pending" sourceRef="C_paidgw" targetRef="C_pending_status" />
    <bpmn:sequenceFlow id="SF_C_pending_C_pending_end" sourceRef="C_pending_status" targetRef="C_pending_end" />
  </bpmn:process>
  <bpmn:process id="Proc_Market" name="Local marketplace ordering" isExecutable="false">
    <bpmn:laneSet id="Market_Lanes">
      <bpmn:lane id="Lane_Checkout" name="Checkout and stock">
        <bpmn:flowNodeRef>M_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_stockgw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_shortage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_revised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_summary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_confirmgw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_cancelEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_M_Validate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Payment" name="Orders and payment">
        <bpmn:flowNodeRef>M_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_paydetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_charge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_gateway_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_paygw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_paid_notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_stock_comm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_retryrecv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_retrygw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_no_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_gateway_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_check_payment_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_status_outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_pending_notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_pending_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_M_PayDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_M_Paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_M_Declined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Delivery" name="Delivery and collection">
        <bpmn:flowNodeRef>M_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_delivergw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_notify_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="M_start" name="Basket received">
      <bpmn:outgoing>SF_M_start_M_validate</bpmn:outgoing>
      <bpmn:messageEventDefinition id="M_start_MessageEventDef" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Join_M_Validate">
      <bpmn:documentation>XOR merge: first-time basket checking or a revised basket recheck. Do not synchronize these mutually exclusive paths.</bpmn:documentation>
      <bpmn:incoming>SF_M_start_M_validate</bpmn:incoming>
      <bpmn:incoming>SF_M_revised_M_validate</bpmn:incoming>
      <bpmn:outgoing>SF_Join_M_Validate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M_validate" name="F1: Validate basket and stock">
      <bpmn:incoming>SF_Join_M_Validate</bpmn:incoming>
      <bpmn:outgoing>SF_M_validate_M_stockgw</bpmn:outgoing>
      <bpmn:property id="Prop_StockInput" name="stockRecords" />
      <bpmn:dataInputAssociation id="Assoc_ReadStock">
        <bpmn:sourceRef>D_Stock</bpmn:sourceRef>
        <bpmn:targetRef>Prop_StockInput</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="M_stockgw" name="In stock?">
      <bpmn:incoming>SF_M_validate_M_stockgw</bpmn:incoming>
      <bpmn:outgoing>SF_M_stockgw_M_shortage</bpmn:outgoing>
      <bpmn:outgoing>SF_M_stockgw_M_summary</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M_shortage" name="Request basket changes">
      <bpmn:incoming>SF_M_stockgw_M_shortage</bpmn:incoming>
      <bpmn:outgoing>SF_M_shortage_M_revised</bpmn:outgoing>
    </bpmn:task>
    <bpmn:receiveTask id="M_revised" name="Receive revised basket">
      <bpmn:incoming>SF_M_shortage_M_revised</bpmn:incoming>
      <bpmn:outgoing>SF_M_revised_M_validate</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:subProcess id="M_summary" name="Identify producers &#38; delivery options">
      <bpmn:documentation>Use Case 2, paragraph 3: after confirming available quantities, the marketplace identifies all producers involved in the basket and determines the applicable delivery or collection arrangements. The order summary and available options are provided for customer review before confirmation. This subprocess is supporting detail within F1 checkout, not another use case.</bpmn:documentation>
      <bpmn:incoming>SF_M_stockgw_M_summary</bpmn:incoming>
      <bpmn:outgoing>SF_M_summary_M_choice</bpmn:outgoing>
      <bpmn:startEvent id="Step02_Available" name="Stock available">
        <bpmn:outgoing>SF_Step02_Available_to_Step02_Producers</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Step02_Producers" name="Identify producers involved">
        <bpmn:incoming>SF_Step02_Available_to_Step02_Producers</bpmn:incoming>
        <bpmn:outgoing>SF_Step02_Producers_to_Step02_Arrangements</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Step02_Arrangements" name="Determine delivery or collection arrangements">
        <bpmn:incoming>SF_Step02_Producers_to_Step02_Arrangements</bpmn:incoming>
        <bpmn:outgoing>SF_Step02_Arrangements_to_Step02_Summary</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Step02_Summary" name="Prepare order summary and available options">
        <bpmn:incoming>SF_Step02_Arrangements_to_Step02_Summary</bpmn:incoming>
        <bpmn:outgoing>SF_Step02_Summary_to_Step02_OptionsReady</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Step02_OptionsReady" name="Options ready for customer">
        <bpmn:incoming>SF_Step02_Summary_to_Step02_OptionsReady</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_Step02_Available_to_Step02_Producers" sourceRef="Step02_Available" targetRef="Step02_Producers" />
      <bpmn:sequenceFlow id="SF_Step02_Producers_to_Step02_Arrangements" sourceRef="Step02_Producers" targetRef="Step02_Arrangements" />
      <bpmn:sequenceFlow id="SF_Step02_Arrangements_to_Step02_Summary" sourceRef="Step02_Arrangements" targetRef="Step02_Summary" />
      <bpmn:sequenceFlow id="SF_Step02_Summary_to_Step02_OptionsReady" sourceRef="Step02_Summary" targetRef="Step02_OptionsReady" />
    </bpmn:subProcess>
    <bpmn:receiveTask id="M_choice" name="Receive customer decision">
      <bpmn:incoming>SF_M_summary_M_choice</bpmn:incoming>
      <bpmn:outgoing>SF_M_choice_M_confirmgw</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="M_confirmgw" name="Confirmed?">
      <bpmn:incoming>SF_M_choice_M_confirmgw</bpmn:incoming>
      <bpmn:outgoing>SF_M_confirmgw_M_cancelEnd</bpmn:outgoing>
      <bpmn:outgoing>SF_M_confirmgw_M_order</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="M_cancelEnd" name="Checkout cancelled">
      <bpmn:incoming>SF_M_confirmgw_M_cancelEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="M_order" name="F2: Create and split order">
      <bpmn:documentation>Use Case 2: create ONE overall marketplace order, then separate it into producer-specific order elements BEFORE charging the sandbox payment service.</bpmn:documentation>
      <bpmn:incoming>SF_M_confirmgw_M_order</bpmn:incoming>
      <bpmn:outgoing>SF_M_order_M_paydetails</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_SaveOrder">
        <bpmn:targetRef>D_Orders</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Join_M_PayDetails">
      <bpmn:documentation>XOR merge: accept details for the first payment attempt or for an expressly requested retry. Neither route requires restarting basket checkout.</bpmn:documentation>
      <bpmn:incoming>SF_M_order_M_paydetails</bpmn:incoming>
      <bpmn:incoming>SF_M_retrygw_M_paydetails</bpmn:incoming>
      <bpmn:outgoing>SF_Join_M_PayDetails</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="M_paydetails" name="Receive payment details">
      <bpmn:incoming>SF_Join_M_PayDetails</bpmn:incoming>
      <bpmn:outgoing>SF_M_paydetails_M_charge</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="M_charge" name="Send payment request">
      <bpmn:incoming>SF_M_paydetails_M_charge</bpmn:incoming>
      <bpmn:outgoing>SF_M_charge_M_gateway_result</bpmn:outgoing>
    </bpmn:task>
    <bpmn:receiveTask id="M_gateway_result" name="Receive gateway result">
      <bpmn:incoming>SF_M_charge_M_gateway_result</bpmn:incoming>
      <bpmn:outgoing>SF_M_gateway_result_M_paygw</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="M_paygw" name="Approved?">
      <bpmn:incoming>SF_M_gateway_result_M_paygw</bpmn:incoming>
      <bpmn:outgoing>SF_M_paygw_M_paid_notice</bpmn:outgoing>
      <bpmn:outgoing>SF_M_paygw_M_declined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_M_Paid">
      <bpmn:documentation>XOR merge: a payment can be confirmed from a normal successful gateway result or after safely checking the status of a timed-out request.</bpmn:documentation>
      <bpmn:incoming>SF_M_paygw_M_paid_notice</bpmn:incoming>
      <bpmn:incoming>SF_M_statusgw_M_paid</bpmn:incoming>
      <bpmn:outgoing>SF_Join_M_Paid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M_paid_notice" name="Confirm successful payment">
      <bpmn:incoming>SF_Join_M_Paid</bpmn:incoming>
      <bpmn:outgoing>SF_M_paid_notice_M_stock_comm</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="M_stock_comm" name="Update stock; calculate producer amounts &#38; 5% commission">
      <bpmn:documentation>Official Use Case 2: only AFTER successful payment, update inventory quantities; calculate the amount attributable to each producer in the multi-vendor order and the marketplace 5% commission. Producer notifications follow this subprocess. Whether and how commission is deducted from individual producer payouts is not specified here; do not assume a settlement rule without group agreement.</bpmn:documentation>
      <bpmn:incoming>SF_M_paid_notice_M_stock_comm</bpmn:incoming>
      <bpmn:outgoing>SF_M_stock_comm_M_notify</bpmn:outgoing>
      <bpmn:startEvent id="FinStart" name="Payment successful">
        <bpmn:outgoing>SF_UC2_FinStart_FinStock</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="FinStock" name="Update purchased stock quantities">
        <bpmn:incoming>SF_UC2_FinStart_FinStock</bpmn:incoming>
        <bpmn:outgoing>SF_UC2_FinStock_FinShares</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="FinShares" name="Calculate amount attributable to each producer">
        <bpmn:incoming>SF_UC2_FinStock_FinShares</bpmn:incoming>
        <bpmn:outgoing>SF_UC2_FinShares_FinFee</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="FinFee" name="Calculate marketplace 5% commission">
        <bpmn:incoming>SF_UC2_FinShares_FinFee</bpmn:incoming>
        <bpmn:outgoing>SF_UC2_FinFee_FinRecord</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="FinRecord" name="Record producer amounts and commission">
        <bpmn:incoming>SF_UC2_FinFee_FinRecord</bpmn:incoming>
        <bpmn:outgoing>SF_UC2_FinRecord_FinEnd</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="FinEnd" name="Stock and amounts recorded">
        <bpmn:incoming>SF_UC2_FinRecord_FinEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF_UC2_FinStart_FinStock" sourceRef="FinStart" targetRef="FinStock" />
      <bpmn:sequenceFlow id="SF_UC2_FinStock_FinShares" sourceRef="FinStock" targetRef="FinShares" />
      <bpmn:sequenceFlow id="SF_UC2_FinShares_FinFee" sourceRef="FinShares" targetRef="FinFee" />
      <bpmn:sequenceFlow id="SF_UC2_FinFee_FinRecord" sourceRef="FinFee" targetRef="FinRecord" />
      <bpmn:sequenceFlow id="SF_UC2_FinRecord_FinEnd" sourceRef="FinRecord" targetRef="FinEnd" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Join_M_Declined">
      <bpmn:documentation>XOR merge: a definite decline can be received directly or discovered from the payment-status check. Both require offering retry/cancel to the customer.</bpmn:documentation>
      <bpmn:incoming>SF_M_paygw_M_declined</bpmn:incoming>
      <bpmn:incoming>SF_M_statusgw_M_declined</bpmn:incoming>
      <bpmn:outgoing>SF_Join_M_Declined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M_declined" name="Tell customer payment declined">
      <bpmn:incoming>SF_Join_M_Declined</bpmn:incoming>
      <bpmn:outgoing>SF_M_declined_M_retryrecv</bpmn:outgoing>
    </bpmn:task>
    <bpmn:receiveTask id="M_retryrecv" name="Receive retry or cancel choice">
      <bpmn:incoming>SF_M_declined_M_retryrecv</bpmn:incoming>
      <bpmn:outgoing>SF_M_retryrecv_M_retrygw</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="M_retrygw" name="Retry?">
      <bpmn:incoming>SF_M_retryrecv_M_retrygw</bpmn:incoming>
      <bpmn:outgoing>SF_M_retrygw_M_no_order</bpmn:outgoing>
      <bpmn:outgoing>SF_M_retrygw_M_paydetails</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="M_no_order" name="Unpaid order closed">
      <bpmn:incoming>SF_M_retrygw_M_no_order</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="M_notify" name="Notify each relevant producer">
      <bpmn:incoming>SF_M_stock_comm_M_notify</bpmn:incoming>
      <bpmn:outgoing>SF_M_notify_M_ready</bpmn:outgoing>
    </bpmn:task>
    <bpmn:receiveTask id="M_ready" name="Receive producer-ready updates">
      <bpmn:incoming>SF_M_notify_M_ready</bpmn:incoming>
      <bpmn:outgoing>SF_M_ready_M_delivergw</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="M_delivergw" name="Chosen handover method?">
      <bpmn:documentation>Use the delivery or collection arrangement that was determined during checkout and selected by the customer before confirmation. No regional, cost, timing or producer lead-time rule is supplied by Use Case 2.</bpmn:documentation>
      <bpmn:incoming>SF_M_ready_M_delivergw</bpmn:incoming>
      <bpmn:outgoing>SF_M_delivergw_M_delivery</bpmn:outgoing>
      <bpmn:outgoing>SF_M_delivergw_M_collect</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M_delivery" name="Arrange delivery">
      <bpmn:incoming>SF_M_delivergw_M_delivery</bpmn:incoming>
      <bpmn:outgoing>SF_M_delivery_M_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="M_collect" name="Arrange collection">
      <bpmn:incoming>SF_M_delivergw_M_collect</bpmn:incoming>
      <bpmn:outgoing>SF_M_collect_M_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="M_join" name="">
      <bpmn:incoming>SF_M_delivery_M_join</bpmn:incoming>
      <bpmn:incoming>SF_M_collect_M_join</bpmn:incoming>
      <bpmn:outgoing>SF_M_join_M_notify_customer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M_notify_customer" name="Send handover details">
      <bpmn:incoming>SF_M_join_M_notify_customer</bpmn:incoming>
      <bpmn:outgoing>SF_M_notify_customer_M_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="M_end" name="Handover arranged">
      <bpmn:incoming>SF_M_notify_customer_M_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_Join_M_Validate" sourceRef="Join_M_Validate" targetRef="M_validate" />
    <bpmn:sequenceFlow id="SF_M_start_M_validate" sourceRef="M_start" targetRef="Join_M_Validate" />
    <bpmn:sequenceFlow id="SF_M_validate_M_stockgw" sourceRef="M_validate" targetRef="M_stockgw" />
    <bpmn:sequenceFlow id="SF_M_stockgw_M_shortage" name="No" sourceRef="M_stockgw" targetRef="M_shortage" />
    <bpmn:sequenceFlow id="SF_M_shortage_M_revised" sourceRef="M_shortage" targetRef="M_revised" />
    <bpmn:sequenceFlow id="SF_M_revised_M_validate" sourceRef="M_revised" targetRef="Join_M_Validate" />
    <bpmn:sequenceFlow id="SF_M_stockgw_M_summary" name="Yes" sourceRef="M_stockgw" targetRef="M_summary" />
    <bpmn:sequenceFlow id="SF_M_summary_M_choice" sourceRef="M_summary" targetRef="M_choice" />
    <bpmn:sequenceFlow id="SF_M_choice_M_confirmgw" sourceRef="M_choice" targetRef="M_confirmgw" />
    <bpmn:sequenceFlow id="SF_M_confirmgw_M_cancelEnd" name="No" sourceRef="M_confirmgw" targetRef="M_cancelEnd" />
    <bpmn:sequenceFlow id="SF_M_confirmgw_M_order" name="Yes" sourceRef="M_confirmgw" targetRef="M_order" />
    <bpmn:sequenceFlow id="SF_Join_M_PayDetails" sourceRef="Join_M_PayDetails" targetRef="M_paydetails" />
    <bpmn:sequenceFlow id="SF_M_order_M_paydetails" sourceRef="M_order" targetRef="Join_M_PayDetails" />
    <bpmn:sequenceFlow id="SF_M_paydetails_M_charge" sourceRef="M_paydetails" targetRef="M_charge" />
    <bpmn:sequenceFlow id="SF_M_charge_M_gateway_result" sourceRef="M_charge" targetRef="M_gateway_result" />
    <bpmn:sequenceFlow id="SF_M_gateway_result_M_paygw" sourceRef="M_gateway_result" targetRef="M_paygw" />
    <bpmn:sequenceFlow id="SF_Join_M_Paid" sourceRef="Join_M_Paid" targetRef="M_paid_notice" />
    <bpmn:sequenceFlow id="SF_M_paygw_M_paid_notice" name="Yes" sourceRef="M_paygw" targetRef="Join_M_Paid" />
    <bpmn:sequenceFlow id="SF_M_paid_notice_M_stock_comm" sourceRef="M_paid_notice" targetRef="M_stock_comm" />
    <bpmn:sequenceFlow id="SF_Join_M_Declined" sourceRef="Join_M_Declined" targetRef="M_declined" />
    <bpmn:sequenceFlow id="SF_M_paygw_M_declined" name="No" sourceRef="M_paygw" targetRef="Join_M_Declined" />
    <bpmn:sequenceFlow id="SF_M_declined_M_retryrecv" sourceRef="M_declined" targetRef="M_retryrecv" />
    <bpmn:sequenceFlow id="SF_M_retryrecv_M_retrygw" sourceRef="M_retryrecv" targetRef="M_retrygw" />
    <bpmn:sequenceFlow id="SF_M_retrygw_M_no_order" name="No" sourceRef="M_retrygw" targetRef="M_no_order" />
    <bpmn:sequenceFlow id="SF_M_retrygw_M_paydetails" name="Yes" sourceRef="M_retrygw" targetRef="Join_M_PayDetails" />
    <bpmn:sequenceFlow id="SF_M_stock_comm_M_notify" sourceRef="M_stock_comm" targetRef="M_notify" />
    <bpmn:sequenceFlow id="SF_M_notify_M_ready" sourceRef="M_notify" targetRef="M_ready" />
    <bpmn:sequenceFlow id="SF_M_ready_M_delivergw" sourceRef="M_ready" targetRef="M_delivergw" />
    <bpmn:sequenceFlow id="SF_M_delivergw_M_delivery" name="Delivery" sourceRef="M_delivergw" targetRef="M_delivery" />
    <bpmn:sequenceFlow id="SF_M_delivergw_M_collect" name="Collection" sourceRef="M_delivergw" targetRef="M_collect" />
    <bpmn:sequenceFlow id="SF_M_delivery_M_join" sourceRef="M_delivery" targetRef="M_join" />
    <bpmn:sequenceFlow id="SF_M_collect_M_join" sourceRef="M_collect" targetRef="M_join" />
    <bpmn:sequenceFlow id="SF_M_join_M_notify_customer" sourceRef="M_join" targetRef="M_notify_customer" />
    <bpmn:sequenceFlow id="SF_M_notify_customer_M_end" sourceRef="M_notify_customer" targetRef="M_end" />
    <bpmn:dataStoreReference id="D_Stock" name="Stock levels" dataStoreRef="DS_ProductStock" />
    <bpmn:dataStoreReference id="D_Orders" name="Order records" dataStoreRef="DS_Order" />
    <bpmn:boundaryEvent id="M_gateway_timeout" name="No gateway reply" attachedToRef="M_gateway_result">
      <bpmn:documentation>UC2 requires an alternative path if the sandbox gateway is temporarily unavailable. The timeout length is NOT given in the use case. paymentResponseTimeout is a proposed duration process variable to be agreed and configured by the group in an operational model, not a working runtime value in this strategic draft.</bpmn:documentation>
      <bpmn:outgoing>SF_M_timeout_M_check</bpmn:outgoing>
      <bpmn:timerEventDefinition id="M_gateway_timeout_TimerDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=paymentResponseTimeout</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="M_check_payment_status" name="Check payment status">
      <bpmn:documentation>After missing gateway reply, enquire using the EXISTING order/payment reference instead of recharging. A status enquiry must not create another payment.</bpmn:documentation>
      <bpmn:incoming>SF_M_timeout_M_check</bpmn:incoming>
      <bpmn:outgoing>SF_M_check_M_statusgw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="M_status_outcome" name="Payment status?">
      <bpmn:documentation>Status check may find an approved transaction, a declined transaction, or an unresolved/unknown transaction. In execution, each conditional path requires reliable process data.</bpmn:documentation>
      <bpmn:incoming>SF_M_check_M_statusgw</bpmn:incoming>
      <bpmn:outgoing>SF_M_statusgw_M_paid</bpmn:outgoing>
      <bpmn:outgoing>SF_M_statusgw_M_declined</bpmn:outgoing>
      <bpmn:outgoing>SF_M_statusgw_M_pending</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="M_pending_notice" name="Tell customer status is pending">
      <bpmn:documentation>Inform the customer that payment could not be confirmed. Do not decrement stock, send producer orders, or incorrectly claim nothing was charged. Investigate/reconcile this pending transaction.</bpmn:documentation>
      <bpmn:incoming>SF_M_statusgw_M_pending</bpmn:incoming>
      <bpmn:outgoing>SF_M_pending_M_pending_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="M_pending_end" name="Payment pending reconciliation">
      <bpmn:documentation>This conceptual endpoint is an unresolved payment requiring later reconciliation. It is NOT a declined payment or a completed purchase. The operational F2 model must specify the actual safe follow-up mechanism and its trigger.</bpmn:documentation>
      <bpmn:incoming>SF_M_pending_M_pending_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_M_timeout_M_check" sourceRef="M_gateway_timeout" targetRef="M_check_payment_status" />
    <bpmn:sequenceFlow id="SF_M_check_M_statusgw" sourceRef="M_check_payment_status" targetRef="M_status_outcome" />
    <bpmn:sequenceFlow id="SF_M_statusgw_M_paid" name="Approved" sourceRef="M_status_outcome" targetRef="Join_M_Paid" />
    <bpmn:sequenceFlow id="SF_M_statusgw_M_declined" name="Declined" sourceRef="M_status_outcome" targetRef="Join_M_Declined" />
    <bpmn:sequenceFlow id="SF_M_statusgw_M_pending" name="Unknown" sourceRef="M_status_outcome" targetRef="M_pending_notice" />
    <bpmn:sequenceFlow id="SF_M_pending_M_pending_end" sourceRef="M_pending_notice" targetRef="M_pending_end" />
    <bpmn:textAnnotation id="Note_Scope">
      <bpmn:text>SCOPE: Use Case 2 only.
Producer onboarding, listings and food-safety processes
are supporting enterprise context, not modelled here.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:dataStore id="DS_ProductStock" name="Product and stock records" />
  <bpmn:dataStore id="DS_Order" name="Order and producer records" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_TeacherFeedback">
    <bpmndi:BPMNPlane id="BPMNPlane_TeacherFeedback" bpmnElement="Collaboration_UC2_TeacherFeedback">
      <bpmndi:BPMNShape id="Pool_Customer_di" bpmnElement="Pool_Customer" isHorizontal="true">
        <dc:Bounds x="135" y="52" width="3370" height="310" />
      </bpmndi:BPMNShape>
