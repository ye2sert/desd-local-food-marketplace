        <dc:Bounds x="205" y="155" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="153" y="196" width="140" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_browse_di" bpmnElement="C_browse">
        <dc:Bounds x="283" y="134" width="126" height="78" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_basket_di" bpmnElement="C_basket">
        <dc:Bounds x="448" y="134" width="126" height="78" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_submit_di" bpmnElement="C_submit">
        <dc:Bounds x="613" y="134" width="126" height="78" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_C_StockResult_di" bpmnElement="Join_C_StockResult" isMarkerVisible="true">
        <dc:Bounds x="766" y="221" width="44" height="44" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_stockresult_di" bpmnElement="C_stockresult">
        <dc:Bounds x="773" y="155" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="748" y="208" width="95" height="25" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_stockgw_di" bpmnElement="C_stockgw" isMarkerVisible="true">
        <dc:Bounds x="858" y="148" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="833" y="121" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_amend_di" bpmnElement="C_amend">
        <dc:Bounds x="830" y="246" width="132" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_resubmit_di" bpmnElement="C_resubmit">
        <dc:Bounds x="1010" y="246" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_method_di" bpmnElement="C_method">
        <dc:Bounds x="983" y="134" width="155" height="78" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_review_di" bpmnElement="C_review">
        <dc:Bounds x="1171" y="134" width="135" height="78" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_confirmgw_di" bpmnElement="C_confirmgw" isMarkerVisible="true">
        <dc:Bounds x="1340" y="148" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1315" y="121" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_confirm_di" bpmnElement="C_confirm">
        <dc:Bounds x="1435" y="134" width="132" height="78" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_cancel_di" bpmnElement="C_cancel">
        <dc:Bounds x="1335" y="246" width="138" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_cancelEnd_di" bpmnElement="C_cancelEnd">
        <dc:Bounds x="1532" y="260" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1480" y="301" width="140" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_C_PayDetails_di" bpmnElement="Join_C_PayDetails" isMarkerVisible="true">
        <dc:Bounds x="1668" y="228" width="46" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_pay_di" bpmnElement="C_pay">
        <dc:Bounds x="1617" y="134" width="148" height="78" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_result_di" bpmnElement="C_result">
        <dc:Bounds x="1803" y="155" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1751" y="196" width="140" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_paidgw_di" bpmnElement="C_paidgw" isMarkerVisible="true">
        <dc:Bounds x="1885" y="148" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1940" y="117" width="130" height="22" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
