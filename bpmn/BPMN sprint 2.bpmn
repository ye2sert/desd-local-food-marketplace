<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:bioc="http://bpmn.io/schema/bioc/1.0" id="Definitions_UC2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="64767e4" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:message id="Message_Basket" name="Basket" />
  <bpmn:message id="Message_OrderSummary" name="Order summary" />
  <bpmn:message id="Message_ItemsUnavailable" name="Items unavailable" />
  <bpmn:message id="Message_RevisedBasket" name="Revised basket" />
  <bpmn:message id="Message_CancelOrder" name="Cancel order" />
  <bpmn:message id="Message_PaymentDetails" name="Payment details" />
  <bpmn:message id="Message_OrderConfirmation" name="Order confirmation" />
  <bpmn:message id="Message_PaymentPending" name="Payment pending" />
  <bpmn:message id="Message_PaymentDeclined" name="Payment declined" />
  <bpmn:message id="Message_DeliveryTime" name="Delivery time" />
  <bpmn:message id="Message_CustomerDecision" name="Customer decision" />
  <bpmn:message id="Message_ReadyForHandover" name="Ready for handover" />
  <bpmn:message id="Message_HandOverDone" name="Hand-over done" />
  <bpmn:message id="Message_OrderNotice" name="Order notice" />
  <bpmn:message id="Message_ProducerConfirms" name="Producer confirms" />
  <bpmn:message id="Message_PaymentRequest" name="Payment request" />
  <bpmn:message id="Message_GatewayApproved" name="Gateway approved" />
  <bpmn:message id="Message_GatewayDeclined" name="Gateway declined" />
  <bpmn:message id="Message_StatusEnquiry" name="Status enquiry" />
  <bpmn:message id="Message_StatusResponse" name="Status response" />
  <bpmn:error id="Error_GatewayNotAnswering" name="GatewayNotAnswering" errorCode="GATEWAYNOTANSWERING" />
  <bpmn:collaboration id="Collaboration_UC2" name="BPMN sprint 2">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer">
      <bpmn:documentation>Customer of the Bristol Regional Food Network marketplace (UC2).</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_Marketplace" name="Local Food Marketplace" processRef="Process_Marketplace" />
    <bpmn:participant id="Participant_Gateway" name="Payment gateway (sandbox)" processRef="Process_Gateway">
      <bpmn:documentation>External or simulated payment service. UC2 and the brief: use a sandbox, never a live payment system.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_Producers" name="Local producers (each of the 40 SMEs)" processRef="Process_Producers">
      <bpmn:documentation>Producers differ in technical ability: some only use email and phone (case study). They need at least 48 hours' notice.</bpmn:documentation>
      <bpmn:participantMultiplicity minimum="1" maximum="40" />
    </bpmn:participant>
    <bpmn:messageFlow id="Message_85_Basket" sourceRef="C_Send" targetRef="M_Start" />
    <bpmn:messageFlow id="Message_86_ItemsUnavailable" sourceRef="M_Short" targetRef="C_Unav" />
    <bpmn:messageFlow id="Message_87_OrderSummary" sourceRef="M_Ident" targetRef="C_Sum" />
    <bpmn:messageFlow id="Message_88_RevisedBasket" name="Revised basket" sourceRef="C_Resub" targetRef="M_Rev" />
    <bpmn:messageFlow id="Message_89_PurchaseConfirmed" name="Purchase confirmed" sourceRef="C_Confirm" targetRef="M_Dec" />
    <bpmn:messageFlow id="Message_90_CancelOrder" sourceRef="C_Abandon" targetRef="M_Dec" />
    <bpmn:messageFlow id="Message_91_PaymentDetails" name="Payment details" sourceRef="C_Pay" targetRef="M_Rcv" />
    <bpmn:messageFlow id="Message_92_OrderConfirmation" sourceRef="M_Conf2" targetRef="C_OrdConf" />
    <bpmn:messageFlow id="Message_93_PaymentDeclined" sourceRef="M_Decl" targetRef="C_DeclC" />
    <bpmn:messageFlow id="Message_94_PaymentPending" sourceRef="M_Pend" targetRef="C_PendC" />
    <bpmn:messageFlow id="Message_95_DeliveryTime" sourceRef="M_SendHO" targetRef="C_DelivC" />
    <bpmn:messageFlow id="Message_96_PaymentRequest" sourceRef="M_Ask" targetRef="G_Start" />
    <bpmn:messageFlow id="Message_97_GatewayApproved" sourceRef="G_Ok" targetRef="M_Ask" />
    <bpmn:messageFlow id="Message_98_GatewayDeclined" sourceRef="G_No" targetRef="M_Ask" />
    <bpmn:messageFlow id="Message_99_StatusEnquiry" sourceRef="M_Chk" targetRef="G_SStart" />
    <bpmn:messageFlow id="Message_100_StatusResponse" sourceRef="G_SEnd" targetRef="M_Chk" />
    <bpmn:messageFlow id="Message_101_OrderNotice" sourceRef="M_Notify" targetRef="P_Start" />
    <bpmn:messageFlow id="Message_102_ProducerConfirms" name="Producer confirms" sourceRef="P_Ack" targetRef="M_Notify" />
    <bpmn:messageFlow id="Message_103_ReadyForHandover" sourceRef="P_Ready" targetRef="M_RR" />
    <bpmn:messageFlow id="Message_104_HandOverDone" sourceRef="P_End" targetRef="M_RHO" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Customer" name="Customer" isExecutable="false">
    <bpmn:startEvent id="C_Start" name="Wants local food">
      <bpmn:outgoing>Flow_1_C_Start_To_C_Browse</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="C_Browse" name="Browse or search products">
      <bpmn:documentation>UC2: the customer browses or searches the marketplace.</bpmn:documentation>
      <bpmn:incoming>Flow_1_C_Start_To_C_Browse</bpmn:incoming>
      <bpmn:outgoing>Flow_2_C_Browse_To_C_Basket</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="C_Basket" name="Add products to basket">
      <bpmn:documentation>UC2: products from ONE OR MORE producers go in one basket.</bpmn:documentation>
      <bpmn:incoming>Flow_2_C_Browse_To_C_Basket</bpmn:incoming>
      <bpmn:outgoing>Flow_3_C_Basket_To_C_Send</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="C_Send" name="Go to checkout">
      <bpmn:incoming>Flow_3_C_Basket_To_C_Send</bpmn:incoming>
      <bpmn:outgoing>Flow_4_C_Send_To_C_JS</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="C_JS" name="">
      <bpmn:incoming>Flow_4_C_Send_To_C_JS</bpmn:incoming>
      <bpmn:incoming>Flow_27_C_Resub_To_C_JS</bpmn:incoming>
      <bpmn:outgoing>Flow_5_C_JS_To_C_EG</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="C_EG" name="Stock result">
      <bpmn:incoming>Flow_5_C_JS_To_C_EG</bpmn:incoming>
      <bpmn:outgoing>Flow_6_C_EG_To_C_Sum</bpmn:outgoing>
      <bpmn:outgoing>Flow_7_C_EG_To_C_Unav</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="C_Sum" name="Order summary">
      <bpmn:incoming>Flow_6_C_EG_To_C_Sum</bpmn:incoming>
      <bpmn:outgoing>Flow_10_C_Sum_To_C_Review</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_Sum_def" messageRef="Message_OrderSummary" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C_Unav" name="Items unavailable">
      <bpmn:incoming>Flow_7_C_EG_To_C_Unav</bpmn:incoming>
      <bpmn:outgoing>Flow_8_C_Unav_To_C_Amend</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_Unav_def" messageRef="Message_ItemsUnavailable" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="C_Amend" name="Amend basket">
      <bpmn:documentation>UC2: if an item is unavailable the customer is told and asked to amend the order.</bpmn:documentation>
      <bpmn:incoming>Flow_8_C_Unav_To_C_Amend</bpmn:incoming>
      <bpmn:outgoing>Flow_9_C_Amend_To_C_Resub</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="C_Resub" name="Resubmit basket">
      <bpmn:incoming>Flow_9_C_Amend_To_C_Resub</bpmn:incoming>
      <bpmn:outgoing>Flow_27_C_Resub_To_C_JS</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="C_Review" name="Review order">
      <bpmn:documentation>UC2: the customer reviews the order, the producer split and the delivery or collection arrangements.</bpmn:documentation>
      <bpmn:incoming>Flow_10_C_Sum_To_C_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_11_C_Review_To_C_Conf</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="C_Conf" name="Confirm?">
      <bpmn:incoming>Flow_11_C_Review_To_C_Conf</bpmn:incoming>
      <bpmn:outgoing>Flow_12_C_Conf_To_C_Confirm</bpmn:outgoing>
      <bpmn:outgoing>Flow_13_C_Conf_To_C_Abandon</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="C_Confirm" name="Confirm purchase">
      <bpmn:incoming>Flow_12_C_Conf_To_C_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_14_C_Confirm_To_C_JP</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="C_Abandon" name="Checkout stopped">
      <bpmn:incoming>Flow_13_C_Conf_To_C_Abandon</bpmn:incoming>
      <bpmn:messageEventDefinition id="C_Abandon_def" messageRef="Message_CancelOrder" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="C_JP" name="">
      <bpmn:incoming>Flow_14_C_Confirm_To_C_JP</bpmn:incoming>
      <bpmn:incoming>Flow_28_C_New_To_C_JP</bpmn:incoming>
      <bpmn:outgoing>Flow_15_C_JP_To_C_Pay</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="C_Pay" name="Enter payment details">
      <bpmn:incoming>Flow_15_C_JP_To_C_Pay</bpmn:incoming>
      <bpmn:outgoing>Flow_16_C_Pay_To_C_EG2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="C_EG2" name="Payment result">
      <bpmn:incoming>Flow_16_C_Pay_To_C_EG2</bpmn:incoming>
      <bpmn:outgoing>Flow_17_C_EG2_To_C_OrdConf</bpmn:outgoing>
      <bpmn:outgoing>Flow_18_C_EG2_To_C_PendC</bpmn:outgoing>
      <bpmn:outgoing>Flow_19_C_EG2_To_C_DeclC</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="C_OrdConf" name="Order confirmed">
      <bpmn:incoming>Flow_17_C_EG2_To_C_OrdConf</bpmn:incoming>
      <bpmn:outgoing>Flow_24_C_OrdConf_To_C_DelivC</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_OrdConf_def" messageRef="Message_OrderConfirmation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C_PendC" name="Payment is being checked">
      <bpmn:incoming>Flow_18_C_EG2_To_C_PendC</bpmn:incoming>
      <bpmn:outgoing>Flow_20_C_PendC_To_C_PendEnd</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_PendC_def" messageRef="Message_PaymentPending" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="C_PendEnd" name="Waiting for payment update">
      <bpmn:incoming>Flow_20_C_PendC_To_C_PendEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="C_DeclC" name="Payment declined">
      <bpmn:incoming>Flow_19_C_EG2_To_C_DeclC</bpmn:incoming>
      <bpmn:outgoing>Flow_21_C_DeclC_To_C_Try</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_DeclC_def" messageRef="Message_PaymentDeclined" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="C_Try" name="Try another method?">
      <bpmn:incoming>Flow_21_C_DeclC_To_C_Try</bpmn:incoming>
      <bpmn:outgoing>Flow_22_C_Try_To_C_New</bpmn:outgoing>
      <bpmn:outgoing>Flow_23_C_Try_To_C_Abn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="C_New" name="Choose another payment method">
      <bpmn:documentation>Teacher feedback and UC2: a declined payment gives the customer another way to pay. The basket and order are kept. Nothing restarts.</bpmn:documentation>
      <bpmn:incoming>Flow_22_C_Try_To_C_New</bpmn:incoming>
      <bpmn:outgoing>Flow_28_C_New_To_C_JP</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="C_Abn" name="Payment abandoned">
      <bpmn:incoming>Flow_23_C_Try_To_C_Abn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="C_DelivC" name="Delivery or collection time">
      <bpmn:incoming>Flow_24_C_OrdConf_To_C_DelivC</bpmn:incoming>
      <bpmn:outgoing>Flow_25_C_DelivC_To_C_Receive</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_DelivC_def" messageRef="Message_DeliveryTime" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="C_Receive" name="Receive or collect the food">
      <bpmn:incoming>Flow_25_C_DelivC_To_C_Receive</bpmn:incoming>
      <bpmn:outgoing>Flow_26_C_Receive_To_C_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="C_End" name="Order received">
      <bpmn:incoming>Flow_26_C_Receive_To_C_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1_C_Start_To_C_Browse" sourceRef="C_Start" targetRef="C_Browse" />
    <bpmn:sequenceFlow id="Flow_2_C_Browse_To_C_Basket" sourceRef="C_Browse" targetRef="C_Basket" />
    <bpmn:sequenceFlow id="Flow_3_C_Basket_To_C_Send" sourceRef="C_Basket" targetRef="C_Send" />
    <bpmn:sequenceFlow id="Flow_4_C_Send_To_C_JS" sourceRef="C_Send" targetRef="C_JS" />
    <bpmn:sequenceFlow id="Flow_5_C_JS_To_C_EG" sourceRef="C_JS" targetRef="C_EG" />
    <bpmn:sequenceFlow id="Flow_6_C_EG_To_C_Sum" sourceRef="C_EG" targetRef="C_Sum" />
    <bpmn:sequenceFlow id="Flow_7_C_EG_To_C_Unav" sourceRef="C_EG" targetRef="C_Unav" />
    <bpmn:sequenceFlow id="Flow_8_C_Unav_To_C_Amend" sourceRef="C_Unav" targetRef="C_Amend" />
    <bpmn:sequenceFlow id="Flow_9_C_Amend_To_C_Resub" sourceRef="C_Amend" targetRef="C_Resub" />
    <bpmn:sequenceFlow id="Flow_10_C_Sum_To_C_Review" sourceRef="C_Sum" targetRef="C_Review" />
    <bpmn:sequenceFlow id="Flow_11_C_Review_To_C_Conf" sourceRef="C_Review" targetRef="C_Conf" />
    <bpmn:sequenceFlow id="Flow_12_C_Conf_To_C_Confirm" name="Yes" sourceRef="C_Conf" targetRef="C_Confirm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=purchaseConfirmed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13_C_Conf_To_C_Abandon" name="No" sourceRef="C_Conf" targetRef="C_Abandon">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=purchaseConfirmed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14_C_Confirm_To_C_JP" sourceRef="C_Confirm" targetRef="C_JP" />
    <bpmn:sequenceFlow id="Flow_15_C_JP_To_C_Pay" sourceRef="C_JP" targetRef="C_Pay" />
    <bpmn:sequenceFlow id="Flow_16_C_Pay_To_C_EG2" sourceRef="C_Pay" targetRef="C_EG2" />
    <bpmn:sequenceFlow id="Flow_17_C_EG2_To_C_OrdConf" sourceRef="C_EG2" targetRef="C_OrdConf" />
    <bpmn:sequenceFlow id="Flow_18_C_EG2_To_C_PendC" sourceRef="C_EG2" targetRef="C_PendC" />
    <bpmn:sequenceFlow id="Flow_19_C_EG2_To_C_DeclC" sourceRef="C_EG2" targetRef="C_DeclC" />
    <bpmn:sequenceFlow id="Flow_20_C_PendC_To_C_PendEnd" sourceRef="C_PendC" targetRef="C_PendEnd" />
    <bpmn:sequenceFlow id="Flow_21_C_DeclC_To_C_Try" sourceRef="C_DeclC" targetRef="C_Try" />
    <bpmn:sequenceFlow id="Flow_22_C_Try_To_C_New" name="Yes" sourceRef="C_Try" targetRef="C_New">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retryPayment = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_23_C_Try_To_C_Abn" name="No" sourceRef="C_Try" targetRef="C_Abn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retryPayment = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24_C_OrdConf_To_C_DelivC" sourceRef="C_OrdConf" targetRef="C_DelivC" />
    <bpmn:sequenceFlow id="Flow_25_C_DelivC_To_C_Receive" sourceRef="C_DelivC" targetRef="C_Receive" />
    <bpmn:sequenceFlow id="Flow_26_C_Receive_To_C_End" sourceRef="C_Receive" targetRef="C_End" />
    <bpmn:sequenceFlow id="Flow_27_C_Resub_To_C_JS" sourceRef="C_Resub" targetRef="C_JS" />
    <bpmn:sequenceFlow id="Flow_28_C_New_To_C_JP" sourceRef="C_New" targetRef="C_JP" />
  </bpmn:process>
  <bpmn:process id="Process_Marketplace" name="Local Food Marketplace" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Marketplace">
      <bpmn:lane id="Lane_Checkout" name="Checkout and stock">
        <bpmn:flowNodeRef>M_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_J1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Stk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Short</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Ident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Cancelled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Orders" name="Orders and payment">
        <bpmn:flowNodeRef>M_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_JR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Rcv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_RcvT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_ClosedEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_AskErr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_JA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Appr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Conf2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Upd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Decl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Ans</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Pend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_PendEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Delivery" name="Delivery and collection">
        <bpmn:flowNodeRef>M_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_RR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_HG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Del</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Col</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Mrg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_SendHO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_RHO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="M_Start" name="Basket received">
      <bpmn:outgoing>Flow_31_M_Start_To_M_J1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="M_Start_def" messageRef="Message_Basket" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="M_J1" name="">
      <bpmn:incoming>Flow_31_M_Start_To_M_J1</bpmn:incoming>
      <bpmn:incoming>Flow_67_M_Rev_To_M_J1</bpmn:incoming>
      <bpmn:outgoing>Flow_32_M_J1_To_M_Check</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="M_Check" name="Check basket and stock">
      <bpmn:documentation>Service task: checks every item against the stock records.</bpmn:documentation>
      <bpmn:incoming>Flow_32_M_J1_To_M_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_33_M_Check_To_M_Stk</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DataAssoc_29">
        <bpmn:sourceRef>DS_Stock</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M_Stk" name="In stock?">
      <bpmn:incoming>Flow_33_M_Check_To_M_Stk</bpmn:incoming>
      <bpmn:outgoing>Flow_34_M_Stk_To_M_Ident</bpmn:outgoing>
      <bpmn:outgoing>Flow_35_M_Stk_To_M_Short</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="M_Short" name="Tell customer items are short">
      <bpmn:incoming>Flow_35_M_Stk_To_M_Short</bpmn:incoming>
      <bpmn:outgoing>Flow_36_M_Short_To_M_Rev</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="M_Rev" name="Receive revised basket" messageRef="Message_RevisedBasket">
      <bpmn:incoming>Flow_36_M_Short_To_M_Rev</bpmn:incoming>
      <bpmn:outgoing>Flow_67_M_Rev_To_M_J1</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:subProcess id="M_Ident" name="Identify producers and delivery options">
      <bpmn:documentation>UC2: the system identifies the producers involved and determines delivery or collection arrangements. Case study: producers need at least 48 hours' notice. Drill down for the steps.</bpmn:documentation>
      <bpmn:incoming>Flow_34_M_Stk_To_M_Ident</bpmn:incoming>
      <bpmn:outgoing>Flow_37_M_Ident_To_M_Dec</bpmn:outgoing>
      <bpmn:startEvent id="M_Ident__s" name="Stock available">
        <bpmn:outgoing>Flow_105_M_Ident__s_To_M_Ident__p</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="M_Ident__p" name="Identify the producers involved">
        <bpmn:incoming>Flow_105_M_Ident__s_To_M_Ident__p</bpmn:incoming>
        <bpmn:outgoing>Flow_106_M_Ident__p_To_M_Ident__d</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="M_Ident__d" name="Work out delivery or collection for each producer">
        <bpmn:incoming>Flow_106_M_Ident__p_To_M_Ident__d</bpmn:incoming>
        <bpmn:outgoing>Flow_107_M_Ident__d_To_M_Ident__n</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="M_Ident__n" name="Check the 48 hours&#39; notice can be met">
        <bpmn:incoming>Flow_107_M_Ident__d_To_M_Ident__n</bpmn:incoming>
        <bpmn:outgoing>Flow_108_M_Ident__n_To_M_Ident__o</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="M_Ident__o" name="Prepare the order summary and options">
        <bpmn:incoming>Flow_108_M_Ident__n_To_M_Ident__o</bpmn:incoming>
        <bpmn:outgoing>Flow_109_M_Ident__o_To_M_Ident__e</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="M_Ident__e" name="Options ready for customer">
        <bpmn:incoming>Flow_109_M_Ident__o_To_M_Ident__e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_105_M_Ident__s_To_M_Ident__p" sourceRef="M_Ident__s" targetRef="M_Ident__p" />
      <bpmn:sequenceFlow id="Flow_106_M_Ident__p_To_M_Ident__d" sourceRef="M_Ident__p" targetRef="M_Ident__d" />
      <bpmn:sequenceFlow id="Flow_107_M_Ident__d_To_M_Ident__n" sourceRef="M_Ident__d" targetRef="M_Ident__n" />
      <bpmn:sequenceFlow id="Flow_108_M_Ident__n_To_M_Ident__o" sourceRef="M_Ident__n" targetRef="M_Ident__o" />
      <bpmn:sequenceFlow id="Flow_109_M_Ident__o_To_M_Ident__e" sourceRef="M_Ident__o" targetRef="M_Ident__e" />
    </bpmn:subProcess>
    <bpmn:receiveTask id="M_Dec" name="Receive customer decision" messageRef="Message_CustomerDecision">
      <bpmn:incoming>Flow_37_M_Ident_To_M_Dec</bpmn:incoming>
      <bpmn:outgoing>Flow_38_M_Dec_To_M_Conf</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="M_Conf" name="Confirmed?">
      <bpmn:incoming>Flow_38_M_Dec_To_M_Conf</bpmn:incoming>
      <bpmn:outgoing>Flow_39_M_Conf_To_M_Cancelled</bpmn:outgoing>
      <bpmn:outgoing>Flow_40_M_Conf_To_M_Order</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="M_Cancelled" name="Checkout cancelled">
      <bpmn:incoming>Flow_39_M_Conf_To_M_Cancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="M_Order" name="Create and split order">
      <bpmn:documentation>UC2: the system creates the overall marketplace order and separates it into producer-specific order elements. The order ID is also the correlation ID for every message that follows (Week 8).</bpmn:documentation>
      <bpmn:incoming>Flow_40_M_Conf_To_M_Order</bpmn:incoming>
      <bpmn:outgoing>Flow_41_M_Order_To_M_JR</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataAssoc_30">
        <bpmn:targetRef>DS_Orders</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="M_Order__s" name="Purchase confirmed">
        <bpmn:outgoing>Flow_110_M_Order__s_To_M_Order__o</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="M_Order__o" name="Create the marketplace order">
        <bpmn:incoming>Flow_110_M_Order__s_To_M_Order__o</bpmn:incoming>
        <bpmn:outgoing>Flow_111_M_Order__o_To_M_Order__sp</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="M_Order__sp" name="Split into producer-specific orders">
        <bpmn:incoming>Flow_111_M_Order__o_To_M_Order__sp</bpmn:incoming>
        <bpmn:outgoing>Flow_112_M_Order__sp_To_M_Order__e</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics />
      </bpmn:serviceTask>
      <bpmn:endEvent id="M_Order__e" name="Order ready for payment">
        <bpmn:incoming>Flow_112_M_Order__sp_To_M_Order__e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_110_M_Order__s_To_M_Order__o" sourceRef="M_Order__s" targetRef="M_Order__o" />
      <bpmn:sequenceFlow id="Flow_111_M_Order__o_To_M_Order__sp" sourceRef="M_Order__o" targetRef="M_Order__sp" />
      <bpmn:sequenceFlow id="Flow_112_M_Order__sp_To_M_Order__e" sourceRef="M_Order__sp" targetRef="M_Order__e" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="M_JR" name="">
      <bpmn:incoming>Flow_41_M_Order_To_M_JR</bpmn:incoming>
      <bpmn:incoming>Flow_68_M_Decl_To_M_JR</bpmn:incoming>
      <bpmn:outgoing>Flow_42_M_JR_To_M_Rcv</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="M_Rcv" name="Receive payment details" messageRef="Message_PaymentDetails">
      <bpmn:documentation>Waits for the customer's payment details. The same task is used again after a decline, so the customer can pay another way without restarting. ASSUMPTION: the 1 day timer closes the unpaid order. The brief gives no duration; the group must agree one (Week 9 cancel timer).</bpmn:documentation>
      <bpmn:incoming>Flow_42_M_JR_To_M_Rcv</bpmn:incoming>
      <bpmn:outgoing>Flow_43_M_Rcv_To_M_Ask</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="M_RcvT" name="After 1 day (assumed)" attachedToRef="M_Rcv">
      <bpmn:outgoing>Flow_50_M_RcvT_To_M_Close</bpmn:outgoing>
      <bpmn:timerEventDefinition id="M_RcvT_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="M_Close" name="Close the unpaid order">
      <bpmn:incoming>Flow_50_M_RcvT_To_M_Close</bpmn:incoming>
      <bpmn:outgoing>Flow_51_M_Close_To_M_ClosedEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="M_ClosedEnd" name="Order closed unpaid">
      <bpmn:incoming>Flow_51_M_Close_To_M_ClosedEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="M_Ask" name="Ask gateway to take payment">
      <bpmn:documentation>UC2 and Week 8: payment goes to the sandbox gateway. Drill down: wait for an answer, 30 second timeout (ASSUMPTION, duration not in the brief), retry with the SAME payment key (idempotency). If the gateway never answers, an error leads to a payment status check, not to a dead end.</bpmn:documentation>
      <bpmn:incoming>Flow_43_M_Rcv_To_M_Ask</bpmn:incoming>
      <bpmn:outgoing>Flow_44_M_Ask_To_M_JA</bpmn:outgoing>
      <bpmn:startEvent id="M_Ask__s" name="Payment details received">
        <bpmn:outgoing>Flow_113_M_Ask__s_To_M_Ask__j</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="M_Ask__j" name="">
        <bpmn:incoming>Flow_113_M_Ask__s_To_M_Ask__j</bpmn:incoming>
        <bpmn:incoming>Flow_124_M_Ask__w_To_M_Ask__j</bpmn:incoming>
        <bpmn:outgoing>Flow_114_M_Ask__j_To_M_Ask__send</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="M_Ask__send" name="Send payment request with a payment key">
        <bpmn:incoming>Flow_114_M_Ask__j_To_M_Ask__send</bpmn:incoming>
        <bpmn:outgoing>Flow_115_M_Ask__send_To_M_Ask__eg</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:eventBasedGateway id="M_Ask__eg" name="Gateway answer?">
        <bpmn:incoming>Flow_115_M_Ask__send_To_M_Ask__eg</bpmn:incoming>
        <bpmn:outgoing>Flow_116_M_Ask__eg_To_M_Ask__ok</bpmn:outgoing>
        <bpmn:outgoing>Flow_118_M_Ask__eg_To_M_Ask__no</bpmn:outgoing>
        <bpmn:outgoing>Flow_120_M_Ask__eg_To_M_Ask__ct</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="M_Ask__ok" name="Gateway approved">
        <bpmn:incoming>Flow_116_M_Ask__eg_To_M_Ask__ok</bpmn:incoming>
        <bpmn:outgoing>Flow_117_M_Ask__ok_To_M_Ask__eok</bpmn:outgoing>
        <bpmn:messageEventDefinition id="M_Ask__ok_def" messageRef="Message_GatewayApproved" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="M_Ask__eok" name="Approved">
        <bpmn:incoming>Flow_117_M_Ask__ok_To_M_Ask__eok</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="M_Ask__no" name="Gateway declined">
        <bpmn:incoming>Flow_118_M_Ask__eg_To_M_Ask__no</bpmn:incoming>
        <bpmn:outgoing>Flow_119_M_Ask__no_To_M_Ask__eno</bpmn:outgoing>
        <bpmn:messageEventDefinition id="M_Ask__no_def" messageRef="Message_GatewayDeclined" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="M_Ask__eno" name="Declined">
        <bpmn:incoming>Flow_119_M_Ask__no_To_M_Ask__eno</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="M_Ask__ct" name="30 seconds, no answer (assumed)">
        <bpmn:incoming>Flow_120_M_Ask__eg_To_M_Ask__ct</bpmn:incoming>
        <bpmn:outgoing>Flow_121_M_Ask__ct_To_M_Ask__g</bpmn:outgoing>
        <bpmn:timerEventDefinition id="M_Ask__ct_def">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="M_Ask__g" name="Tries left?">
        <bpmn:incoming>Flow_121_M_Ask__ct_To_M_Ask__g</bpmn:incoming>
        <bpmn:outgoing>Flow_122_M_Ask__g_To_M_Ask__w</bpmn:outgoing>
        <bpmn:outgoing>Flow_123_M_Ask__g_To_M_Ask__ee</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="M_Ask__w" name="Wait, then ask again with the SAME payment key">
        <bpmn:incoming>Flow_122_M_Ask__g_To_M_Ask__w</bpmn:incoming>
        <bpmn:outgoing>Flow_124_M_Ask__w_To_M_Ask__j</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="M_Ask__ee" name="Gateway not answering">
        <bpmn:incoming>Flow_123_M_Ask__g_To_M_Ask__ee</bpmn:incoming>
        <bpmn:errorEventDefinition id="M_Ask__ee_def" errorRef="Error_GatewayNotAnswering" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_113_M_Ask__s_To_M_Ask__j" sourceRef="M_Ask__s" targetRef="M_Ask__j" />
      <bpmn:sequenceFlow id="Flow_114_M_Ask__j_To_M_Ask__send" sourceRef="M_Ask__j" targetRef="M_Ask__send" />
      <bpmn:sequenceFlow id="Flow_115_M_Ask__send_To_M_Ask__eg" sourceRef="M_Ask__send" targetRef="M_Ask__eg" />
      <bpmn:sequenceFlow id="Flow_116_M_Ask__eg_To_M_Ask__ok" sourceRef="M_Ask__eg" targetRef="M_Ask__ok" />
      <bpmn:sequenceFlow id="Flow_117_M_Ask__ok_To_M_Ask__eok" sourceRef="M_Ask__ok" targetRef="M_Ask__eok" />
      <bpmn:sequenceFlow id="Flow_118_M_Ask__eg_To_M_Ask__no" sourceRef="M_Ask__eg" targetRef="M_Ask__no" />
      <bpmn:sequenceFlow id="Flow_119_M_Ask__no_To_M_Ask__eno" sourceRef="M_Ask__no" targetRef="M_Ask__eno" />
      <bpmn:sequenceFlow id="Flow_120_M_Ask__eg_To_M_Ask__ct" sourceRef="M_Ask__eg" targetRef="M_Ask__ct" />
      <bpmn:sequenceFlow id="Flow_121_M_Ask__ct_To_M_Ask__g" sourceRef="M_Ask__ct" targetRef="M_Ask__g" />
      <bpmn:sequenceFlow id="Flow_122_M_Ask__g_To_M_Ask__w" name="Yes" sourceRef="M_Ask__g" targetRef="M_Ask__w">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=M_AskResult = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_123_M_Ask__g_To_M_Ask__ee" name="No" sourceRef="M_Ask__g" targetRef="M_Ask__ee">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=M_AskResult = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_124_M_Ask__w_To_M_Ask__j" sourceRef="M_Ask__w" targetRef="M_Ask__j" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="M_AskErr" name="No answer" attachedToRef="M_Ask">
      <bpmn:outgoing>Flow_52_M_AskErr_To_M_Chk</bpmn:outgoing>
      <bpmn:errorEventDefinition id="M_AskErr_def" errorRef="Error_GatewayNotAnswering" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="M_JA" name="">
      <bpmn:incoming>Flow_44_M_Ask_To_M_JA</bpmn:incoming>
      <bpmn:incoming>Flow_54_M_Ans_To_M_JA</bpmn:incoming>
      <bpmn:outgoing>Flow_45_M_JA_To_M_Appr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="M_Appr" name="Approved?">
      <bpmn:incoming>Flow_45_M_JA_To_M_Appr</bpmn:incoming>
      <bpmn:outgoing>Flow_46_M_Appr_To_M_Conf2</bpmn:outgoing>
      <bpmn:outgoing>Flow_49_M_Appr_To_M_Decl</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="M_Conf2" name="Confirm order to customer">
      <bpmn:documentation>UC2: if payment is successful the order is confirmed.</bpmn:documentation>
      <bpmn:incoming>Flow_46_M_Appr_To_M_Conf2</bpmn:incoming>
      <bpmn:outgoing>Flow_47_M_Conf2_To_M_Upd</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:subProcess id="M_Upd" name="Update stock, producer amounts and 5% commission">
      <bpmn:documentation>UC2: update stock, calculate the amount for each producer and the marketplace 5% commission (case study). Amounts are kept for the weekly producer settlement.</bpmn:documentation>
      <bpmn:incoming>Flow_47_M_Conf2_To_M_Upd</bpmn:incoming>
      <bpmn:outgoing>Flow_48_M_Upd_To_M_Notify</bpmn:outgoing>
      <bpmn:startEvent id="M_Upd__s" name="Payment approved">
        <bpmn:outgoing>Flow_125_M_Upd__s_To_M_Upd__st</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="M_Upd__st" name="Update the stock quantities">
        <bpmn:incoming>Flow_125_M_Upd__s_To_M_Upd__st</bpmn:incoming>
        <bpmn:outgoing>Flow_126_M_Upd__st_To_M_Upd__sh</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:businessRuleTask id="M_Upd__sh" name="Work out each producer&#39;s amount">
        <bpmn:incoming>Flow_126_M_Upd__st_To_M_Upd__sh</bpmn:incoming>
        <bpmn:outgoing>Flow_127_M_Upd__sh_To_M_Upd__co</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics />
      </bpmn:businessRuleTask>
      <bpmn:businessRuleTask id="M_Upd__co" name="Calculate the 5% commission">
        <bpmn:incoming>Flow_127_M_Upd__sh_To_M_Upd__co</bpmn:incoming>
        <bpmn:outgoing>Flow_128_M_Upd__co_To_M_Upd__r</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:serviceTask id="M_Upd__r" name="Record amounts and commission">
        <bpmn:incoming>Flow_128_M_Upd__co_To_M_Upd__r</bpmn:incoming>
        <bpmn:outgoing>Flow_129_M_Upd__r_To_M_Upd__e</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="M_Upd__e" name="Stock and amounts recorded">
        <bpmn:incoming>Flow_129_M_Upd__r_To_M_Upd__e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_125_M_Upd__s_To_M_Upd__st" sourceRef="M_Upd__s" targetRef="M_Upd__st" />
      <bpmn:sequenceFlow id="Flow_126_M_Upd__st_To_M_Upd__sh" sourceRef="M_Upd__st" targetRef="M_Upd__sh" />
      <bpmn:sequenceFlow id="Flow_127_M_Upd__sh_To_M_Upd__co" sourceRef="M_Upd__sh" targetRef="M_Upd__co" />
      <bpmn:sequenceFlow id="Flow_128_M_Upd__co_To_M_Upd__r" sourceRef="M_Upd__co" targetRef="M_Upd__r" />
      <bpmn:sequenceFlow id="Flow_129_M_Upd__r_To_M_Upd__e" sourceRef="M_Upd__r" targetRef="M_Upd__e" />
    </bpmn:subProcess>
    <bpmn:sendTask id="M_Decl" name="Tell customer payment declined">
      <bpmn:documentation>UC2: if payment is declined the customer is informed and given the chance to retry.</bpmn:documentation>
      <bpmn:incoming>Flow_49_M_Appr_To_M_Decl</bpmn:incoming>
      <bpmn:outgoing>Flow_68_M_Decl_To_M_JR</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="M_Chk" name="Check payment status">
      <bpmn:documentation>Week 8: after no reply, ask the gateway what happened. Never assume the payment failed.</bpmn:documentation>
      <bpmn:incoming>Flow_52_M_AskErr_To_M_Chk</bpmn:incoming>
      <bpmn:outgoing>Flow_53_M_Chk_To_M_Ans</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M_Ans" name="Answer received?">
      <bpmn:incoming>Flow_53_M_Chk_To_M_Ans</bpmn:incoming>
      <bpmn:outgoing>Flow_54_M_Ans_To_M_JA</bpmn:outgoing>
      <bpmn:outgoing>Flow_55_M_Ans_To_M_Pend</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="M_Pend" name="Tell customer payment is pending">
      <bpmn:incoming>Flow_55_M_Ans_To_M_Pend</bpmn:incoming>
      <bpmn:outgoing>Flow_56_M_Pend_To_M_PendEnd</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="M_PendEnd" name="Order held until payment is confirmed">
      <bpmn:incoming>Flow_56_M_Pend_To_M_PendEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="M_Notify" name="Notify each producer">
      <bpmn:documentation>UC2: the relevant producers are notified. Case study: at least 48 hours' notice.</bpmn:documentation>
      <bpmn:incoming>Flow_48_M_Upd_To_M_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_57_M_Notify_To_M_RR</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
      <bpmn:startEvent id="M_Notify__s" name="Order confirmed">
        <bpmn:outgoing>Flow_130_M_Notify__s_To_M_Notify__g</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="M_Notify__g" name="Producer uses the platform?">
        <bpmn:incoming>Flow_130_M_Notify__s_To_M_Notify__g</bpmn:incoming>
        <bpmn:outgoing>Flow_131_M_Notify__g_To_M_Notify__a</bpmn:outgoing>
        <bpmn:outgoing>Flow_132_M_Notify__g_To_M_Notify__b</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="M_Notify__a" name="Show the order in the producer&#39;s list">
        <bpmn:incoming>Flow_131_M_Notify__g_To_M_Notify__a</bpmn:incoming>
        <bpmn:outgoing>Flow_133_M_Notify__a_To_M_Notify__j</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="M_Notify__b" name="Email or phone the order to the producer">
        <bpmn:incoming>Flow_132_M_Notify__g_To_M_Notify__b</bpmn:incoming>
        <bpmn:outgoing>Flow_134_M_Notify__b_To_M_Notify__j</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="M_Notify__j" name="">
        <bpmn:incoming>Flow_133_M_Notify__a_To_M_Notify__j</bpmn:incoming>
        <bpmn:incoming>Flow_134_M_Notify__b_To_M_Notify__j</bpmn:incoming>
        <bpmn:outgoing>Flow_135_M_Notify__j_To_M_Notify__c</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="M_Notify__c" name="Producer confirms">
        <bpmn:incoming>Flow_135_M_Notify__j_To_M_Notify__c</bpmn:incoming>
        <bpmn:outgoing>Flow_136_M_Notify__c_To_M_Notify__e1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="M_Notify__c_def" messageRef="Message_ProducerConfirms" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="M_Notify__e1" name="Producer notified">
        <bpmn:incoming>Flow_136_M_Notify__c_To_M_Notify__e1</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_130_M_Notify__s_To_M_Notify__g" sourceRef="M_Notify__s" targetRef="M_Notify__g" />
      <bpmn:sequenceFlow id="Flow_131_M_Notify__g_To_M_Notify__a" name="Yes" sourceRef="M_Notify__g" targetRef="M_Notify__a">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=M_NotifyResult = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_132_M_Notify__g_To_M_Notify__b" name="No" sourceRef="M_Notify__g" targetRef="M_Notify__b">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=M_NotifyResult = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_133_M_Notify__a_To_M_Notify__j" sourceRef="M_Notify__a" targetRef="M_Notify__j" />
      <bpmn:sequenceFlow id="Flow_134_M_Notify__b_To_M_Notify__j" sourceRef="M_Notify__b" targetRef="M_Notify__j" />
      <bpmn:sequenceFlow id="Flow_135_M_Notify__j_To_M_Notify__c" sourceRef="M_Notify__j" targetRef="M_Notify__c" />
      <bpmn:sequenceFlow id="Flow_136_M_Notify__c_To_M_Notify__e1" sourceRef="M_Notify__c" targetRef="M_Notify__e1" />
    </bpmn:subProcess>
    <bpmn:receiveTask id="M_RR" name="Receive producer-ready updates" messageRef="Message_ReadyForHandover">
      <bpmn:documentation>Waits for EVERY producer to say the order is ready (multi-instance).</bpmn:documentation>
      <bpmn:incoming>Flow_57_M_Notify_To_M_RR</bpmn:incoming>
      <bpmn:outgoing>Flow_58_M_RR_To_M_HG</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="M_HG" name="Handover method?">
      <bpmn:incoming>Flow_58_M_RR_To_M_HG</bpmn:incoming>
      <bpmn:outgoing>Flow_59_M_HG_To_M_Del</bpmn:outgoing>
      <bpmn:outgoing>Flow_60_M_HG_To_M_Col</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="M_Del" name="Arrange delivery">
      <bpmn:incoming>Flow_59_M_HG_To_M_Del</bpmn:incoming>
      <bpmn:outgoing>Flow_61_M_Del_To_M_Mrg</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="M_Col" name="Arrange collection">
      <bpmn:incoming>Flow_60_M_HG_To_M_Col</bpmn:incoming>
      <bpmn:outgoing>Flow_62_M_Col_To_M_Mrg</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M_Mrg" name="">
      <bpmn:incoming>Flow_61_M_Del_To_M_Mrg</bpmn:incoming>
      <bpmn:incoming>Flow_62_M_Col_To_M_Mrg</bpmn:incoming>
      <bpmn:outgoing>Flow_63_M_Mrg_To_M_SendHO</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="M_SendHO" name="Send handover details">
      <bpmn:documentation>How delivery works: the customer is told the delivery or collection time and the producer does the hand-over.</bpmn:documentation>
      <bpmn:incoming>Flow_63_M_Mrg_To_M_SendHO</bpmn:incoming>
      <bpmn:outgoing>Flow_64_M_SendHO_To_M_RHO</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="M_RHO" name="Receive hand-over confirmation" messageRef="Message_HandOverDone">
      <bpmn:incoming>Flow_64_M_SendHO_To_M_RHO</bpmn:incoming>
      <bpmn:outgoing>Flow_65_M_RHO_To_M_Rec</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="M_Rec" name="Record order as handed over">
      <bpmn:incoming>Flow_65_M_RHO_To_M_Rec</bpmn:incoming>
      <bpmn:outgoing>Flow_66_M_Rec_To_M_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="M_End" name="Order complete">
      <bpmn:incoming>Flow_66_M_Rec_To_M_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_31_M_Start_To_M_J1" sourceRef="M_Start" targetRef="M_J1" />
    <bpmn:sequenceFlow id="Flow_32_M_J1_To_M_Check" sourceRef="M_J1" targetRef="M_Check" />
    <bpmn:sequenceFlow id="Flow_33_M_Check_To_M_Stk" sourceRef="M_Check" targetRef="M_Stk" />
    <bpmn:sequenceFlow id="Flow_34_M_Stk_To_M_Ident" name="Yes" sourceRef="M_Stk" targetRef="M_Ident">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=itemsInStock = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_35_M_Stk_To_M_Short" name="No" sourceRef="M_Stk" targetRef="M_Short">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=itemsInStock = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_36_M_Short_To_M_Rev" sourceRef="M_Short" targetRef="M_Rev" />
    <bpmn:sequenceFlow id="Flow_37_M_Ident_To_M_Dec" sourceRef="M_Ident" targetRef="M_Dec" />
    <bpmn:sequenceFlow id="Flow_38_M_Dec_To_M_Conf" sourceRef="M_Dec" targetRef="M_Conf" />
    <bpmn:sequenceFlow id="Flow_39_M_Conf_To_M_Cancelled" name="No" sourceRef="M_Conf" targetRef="M_Cancelled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=purchaseConfirmed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_40_M_Conf_To_M_Order" name="Yes" sourceRef="M_Conf" targetRef="M_Order">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=purchaseConfirmed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_41_M_Order_To_M_JR" sourceRef="M_Order" targetRef="M_JR" />
    <bpmn:sequenceFlow id="Flow_42_M_JR_To_M_Rcv" sourceRef="M_JR" targetRef="M_Rcv" />
    <bpmn:sequenceFlow id="Flow_43_M_Rcv_To_M_Ask" sourceRef="M_Rcv" targetRef="M_Ask" />
    <bpmn:sequenceFlow id="Flow_44_M_Ask_To_M_JA" sourceRef="M_Ask" targetRef="M_JA" />
    <bpmn:sequenceFlow id="Flow_45_M_JA_To_M_Appr" sourceRef="M_JA" targetRef="M_Appr" />
    <bpmn:sequenceFlow id="Flow_46_M_Appr_To_M_Conf2" name="Yes" sourceRef="M_Appr" targetRef="M_Conf2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=gatewayApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_47_M_Conf2_To_M_Upd" sourceRef="M_Conf2" targetRef="M_Upd" />
    <bpmn:sequenceFlow id="Flow_48_M_Upd_To_M_Notify" sourceRef="M_Upd" targetRef="M_Notify" />
    <bpmn:sequenceFlow id="Flow_49_M_Appr_To_M_Decl" name="No" sourceRef="M_Appr" targetRef="M_Decl">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=gatewayApproved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_50_M_RcvT_To_M_Close" sourceRef="M_RcvT" targetRef="M_Close" />
    <bpmn:sequenceFlow id="Flow_51_M_Close_To_M_ClosedEnd" sourceRef="M_Close" targetRef="M_ClosedEnd" />
    <bpmn:sequenceFlow id="Flow_52_M_AskErr_To_M_Chk" sourceRef="M_AskErr" targetRef="M_Chk" />
    <bpmn:sequenceFlow id="Flow_53_M_Chk_To_M_Ans" sourceRef="M_Chk" targetRef="M_Ans" />
    <bpmn:sequenceFlow id="Flow_54_M_Ans_To_M_JA" name="Yes" sourceRef="M_Ans" targetRef="M_JA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=answerReceived = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_55_M_Ans_To_M_Pend" name="No" sourceRef="M_Ans" targetRef="M_Pend">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=answerReceived = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_56_M_Pend_To_M_PendEnd" sourceRef="M_Pend" targetRef="M_PendEnd" />
    <bpmn:sequenceFlow id="Flow_57_M_Notify_To_M_RR" sourceRef="M_Notify" targetRef="M_RR" />
    <bpmn:sequenceFlow id="Flow_58_M_RR_To_M_HG" sourceRef="M_RR" targetRef="M_HG" />
    <bpmn:sequenceFlow id="Flow_59_M_HG_To_M_Del" name="Delivery" sourceRef="M_HG" targetRef="M_Del">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=handoverMethod = "delivery"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_60_M_HG_To_M_Col" name="Collection" sourceRef="M_HG" targetRef="M_Col">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=handoverMethod = "collection"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_61_M_Del_To_M_Mrg" sourceRef="M_Del" targetRef="M_Mrg" />
    <bpmn:sequenceFlow id="Flow_62_M_Col_To_M_Mrg" sourceRef="M_Col" targetRef="M_Mrg" />
    <bpmn:sequenceFlow id="Flow_63_M_Mrg_To_M_SendHO" sourceRef="M_Mrg" targetRef="M_SendHO" />
    <bpmn:sequenceFlow id="Flow_64_M_SendHO_To_M_RHO" sourceRef="M_SendHO" targetRef="M_RHO" />
    <bpmn:sequenceFlow id="Flow_65_M_RHO_To_M_Rec" sourceRef="M_RHO" targetRef="M_Rec" />
    <bpmn:sequenceFlow id="Flow_66_M_Rec_To_M_End" sourceRef="M_Rec" targetRef="M_End" />
    <bpmn:sequenceFlow id="Flow_67_M_Rev_To_M_J1" sourceRef="M_Rev" targetRef="M_J1" />
    <bpmn:sequenceFlow id="Flow_68_M_Decl_To_M_JR" sourceRef="M_Decl" targetRef="M_JR" />
    <bpmn:dataStoreReference id="DS_Stock" name="Stock levels" />
    <bpmn:dataStoreReference id="DS_Orders" name="Order records" />
  </bpmn:process>
  <bpmn:process id="Process_Gateway" name="Payment gateway (sandbox)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Gateway">
      <bpmn:lane id="Lane_GA" name="Take the payment">
        <bpmn:flowNodeRef>G_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_No</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GB" name="Report payment status">
        <bpmn:flowNodeRef>G_SStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Look</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_SEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="G_Start" name="Payment request">
      <bpmn:outgoing>Flow_79_G_Start_To_G_Check</bpmn:outgoing>
      <bpmn:messageEventDefinition id="G_Start_def" messageRef="Message_PaymentRequest" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="G_Check" name="Check the payment">
      <bpmn:incoming>Flow_79_G_Start_To_G_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_80_G_Check_To_G_Gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Gw" name="Approved?">
      <bpmn:incoming>Flow_80_G_Check_To_G_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_81_G_Gw_To_G_Ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_82_G_Gw_To_G_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="G_Ok" name="Approved">
      <bpmn:incoming>Flow_81_G_Gw_To_G_Ok</bpmn:incoming>
      <bpmn:messageEventDefinition id="G_Ok_def" messageRef="Message_GatewayApproved" />
    </bpmn:endEvent>
    <bpmn:endEvent id="G_No" name="Declined">
      <bpmn:incoming>Flow_82_G_Gw_To_G_No</bpmn:incoming>
      <bpmn:messageEventDefinition id="G_No_def" messageRef="Message_GatewayDeclined" />
    </bpmn:endEvent>
    <bpmn:startEvent id="G_SStart" name="Status enquiry">
      <bpmn:outgoing>Flow_83_G_SStart_To_G_Look</bpmn:outgoing>
      <bpmn:messageEventDefinition id="G_SStart_def" messageRef="Message_StatusEnquiry" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="G_Look" name="Look up the payment">
      <bpmn:incoming>Flow_83_G_SStart_To_G_Look</bpmn:incoming>
      <bpmn:outgoing>Flow_84_G_Look_To_G_SEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="G_SEnd" name="Payment status">
      <bpmn:incoming>Flow_84_G_Look_To_G_SEnd</bpmn:incoming>
      <bpmn:messageEventDefinition id="G_SEnd_def" messageRef="Message_StatusResponse" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_79_G_Start_To_G_Check" sourceRef="G_Start" targetRef="G_Check" />
    <bpmn:sequenceFlow id="Flow_80_G_Check_To_G_Gw" sourceRef="G_Check" targetRef="G_Gw" />
    <bpmn:sequenceFlow id="Flow_81_G_Gw_To_G_Ok" name="Yes" sourceRef="G_Gw" targetRef="G_Ok">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=gatewayApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_82_G_Gw_To_G_No" name="No" sourceRef="G_Gw" targetRef="G_No">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=gatewayApproved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_83_G_SStart_To_G_Look" sourceRef="G_SStart" targetRef="G_Look" />
    <bpmn:sequenceFlow id="Flow_84_G_Look_To_G_SEnd" sourceRef="G_Look" targetRef="G_SEnd" />
  </bpmn:process>
  <bpmn:process id="Process_Producers" name="Local producers (each of the 40 SMEs)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Producers">
      <bpmn:lane id="Lane_P1" name="Orders and preparation">
        <bpmn:flowNodeRef>P_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Ack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Ready</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P2" name="Delivery and collection">
        <bpmn:flowNodeRef>P_HG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Coll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Mrg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P_Start" name="Order notice">
      <bpmn:outgoing>Flow_69_P_Start_To_P_Read</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P_Start_def" messageRef="Message_OrderNotice" />
    </bpmn:startEvent>
    <bpmn:userTask id="P_Read" name="Read the order">
      <bpmn:documentation>Case study: producers need clear visibility of incoming orders. Some only use email and telephone.</bpmn:documentation>
      <bpmn:incoming>Flow_69_P_Start_To_P_Read</bpmn:incoming>
      <bpmn:outgoing>Flow_70_P_Read_To_P_Ack</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="P_Ack" name="Confirm order received">
      <bpmn:incoming>Flow_70_P_Read_To_P_Ack</bpmn:incoming>
      <bpmn:outgoing>Flow_71_P_Ack_To_P_Prep</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="P_Prep" name="Prepare the products">
      <bpmn:documentation>Case study: minimum 48 hours' notice to prepare.</bpmn:documentation>
      <bpmn:incoming>Flow_71_P_Ack_To_P_Prep</bpmn:incoming>
      <bpmn:outgoing>Flow_72_P_Prep_To_P_Ready</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="P_Ready" name="Ready for handover">
      <bpmn:incoming>Flow_72_P_Prep_To_P_Ready</bpmn:incoming>
      <bpmn:outgoing>Flow_73_P_Ready_To_P_HG</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P_Ready_def" messageRef="Message_ReadyForHandover" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="P_HG" name="Handover method?">
      <bpmn:incoming>Flow_73_P_Ready_To_P_HG</bpmn:incoming>
      <bpmn:outgoing>Flow_74_P_HG_To_P_Deliver</bpmn:outgoing>
      <bpmn:outgoing>Flow_75_P_HG_To_P_Coll</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P_Deliver" name="Deliver to customer">
      <bpmn:incoming>Flow_74_P_HG_To_P_Deliver</bpmn:incoming>
      <bpmn:outgoing>Flow_76_P_Deliver_To_P_Mrg</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P_Coll" name="Hand over at the farm">
      <bpmn:incoming>Flow_75_P_HG_To_P_Coll</bpmn:incoming>
      <bpmn:outgoing>Flow_77_P_Coll_To_P_Mrg</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P_Mrg" name="">
      <bpmn:incoming>Flow_76_P_Deliver_To_P_Mrg</bpmn:incoming>
      <bpmn:incoming>Flow_77_P_Coll_To_P_Mrg</bpmn:incoming>
      <bpmn:outgoing>Flow_78_P_Mrg_To_P_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P_End" name="Hand-over done">
      <bpmn:incoming>Flow_78_P_Mrg_To_P_End</bpmn:incoming>
      <bpmn:messageEventDefinition id="P_End_def" messageRef="Message_HandOverDone" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_69_P_Start_To_P_Read" sourceRef="P_Start" targetRef="P_Read" />
    <bpmn:sequenceFlow id="Flow_70_P_Read_To_P_Ack" sourceRef="P_Read" targetRef="P_Ack" />
    <bpmn:sequenceFlow id="Flow_71_P_Ack_To_P_Prep" sourceRef="P_Ack" targetRef="P_Prep" />
    <bpmn:sequenceFlow id="Flow_72_P_Prep_To_P_Ready" sourceRef="P_Prep" targetRef="P_Ready" />
    <bpmn:sequenceFlow id="Flow_73_P_Ready_To_P_HG" sourceRef="P_Ready" targetRef="P_HG" />
    <bpmn:sequenceFlow id="Flow_74_P_HG_To_P_Deliver" name="Delivery" sourceRef="P_HG" targetRef="P_Deliver">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=handoverMethod = "delivery"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_75_P_HG_To_P_Coll" name="Collection" sourceRef="P_HG" targetRef="P_Coll">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=handoverMethod = "collection"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_76_P_Deliver_To_P_Mrg" sourceRef="P_Deliver" targetRef="P_Mrg" />
    <bpmn:sequenceFlow id="Flow_77_P_Coll_To_P_Mrg" sourceRef="P_Coll" targetRef="P_Mrg" />
    <bpmn:sequenceFlow id="Flow_78_P_Mrg_To_P_End" sourceRef="P_Mrg" targetRef="P_End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Main">
    <bpmndi:BPMNPlane id="BPMNPlane_Main" bpmnElement="Collaboration_UC2">
      <bpmndi:BPMNShape id="Participant_Customer_di" bpmnElement="Participant_Customer" isHorizontal="true">
        <dc:Bounds x="140" y="40" width="3800" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_Start_di" bpmnElement="C_Start">
        <dc:Bounds x="172" y="97" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="160" y="135" width="60" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_Browse_di" bpmnElement="C_Browse">
        <dc:Bounds x="235" y="79" width="130" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_Basket_di" bpmnElement="C_Basket">
        <dc:Bounds x="385" y="79" width="120" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_Send_di" bpmnElement="C_Send">
        <dc:Bounds x="530" y="79" width="120" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_JS_di" bpmnElement="C_JS" isMarkerVisible="true">
        <dc:Bounds x="665" y="90" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_EG_di" bpmnElement="C_EG">
        <dc:Bounds x="745" y="90" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="720" y="74" width="100" height="14" />
        </bpmndi:BPMNLabel>
